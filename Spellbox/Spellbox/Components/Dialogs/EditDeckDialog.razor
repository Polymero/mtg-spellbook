
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            Edit Deck
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField @bind-Value="_editDto.Name"
                      Label="Name" 
                      Required="true"
                      Immediate="true"
                      Typo="Typo.h5" />

        <MudSelect T="DeckType"
                   Label="Type"
                   @bind-Value="_editDto.Type">
            @foreach (var v in Enum.GetValues<DeckType>())
            {
                <MudSelectItem Value="v">
                    @v
                </MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_editDto.Description" 
                      Label="Description" 
                      Lines="3"
                      Immediate="true" />

        <MudTextField @bind-Value="_editDto.Sleeves"
                      Label="Sleeves" />

        <MudTextField @bind-Value="_editDto.CoverImage"
                      Label="Cover Image" />
    </DialogContent>

    <DialogActions>
        <MudButton Class="mx-2 my-1"
                   Color="Color.Error"
                   Variant="Variant.Outlined"
                   OnClick="DeleteAsync"
                   StartIcon="@Icons.Material.Filled.DeleteForever">
            Delete
        </MudButton>

        <MudButton Class="mx-2 my-1"
                   Color="Color.Warning"
                   Variant="Variant.Outlined"
                   OnClick="TransformAsync">
            To Binder           
        </MudButton>

        <MudSpacer />

        <MudButton Class="mx-2 my-1"
                   Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Class="mx-2 my-1"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync">
            Save Changes
        </MudButton>
    </DialogActions>

</MudDialog>


@inject CollectionService CollectionService
@inject CrossService CrossService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid DeckId { get; set; }

    private EditableDeckDto _editDto = null!;

    protected override async Task OnParametersSetAsync()
    {
        _editDto = await CollectionService.GetEditableDeckAsync(DeckId);
    }


    private async Task SaveAsync()
    {
        var updatedDto = await CollectionService.UpdateDeckAsync(_editDto);
        await CrossService.RefreshDeckPropertiesAsync(_editDto.Id);
        MudDialog.Close(DialogResult.Ok(new EditDeckCallback(
            updatedDto,
            false,
            true,
            false
        )));

        Snackbar.Add($"Changes saved successfully ~ !", Severity.Success);
    }

    private async Task DeleteAsync()
    {
        await CollectionService.DeleteDeckAsync(_editDto.Id);
        MudDialog.Close(DialogResult.Ok(new EditDeckCallback(
            new DeckDto
            {
                Id = _editDto.Id
            },
            false,
            false,
            true
        )));

        Snackbar.Add($"Deck '{_editDto.Name}' deleted.", Severity.Success);
    }

    private async Task TransformAsync()
    {
        var binder = await CollectionService.TransformDeckIntoBinderAsync(_editDto);
        MudDialog.Close(DialogResult.Ok(new EditDeckCallback(
            new DeckDto
            {
                Id = _editDto.Id
            },
            false,
            false,
            true,
            Transformed: binder
        )));
    }


    private void Cancel() => MudDialog.Cancel();

}
