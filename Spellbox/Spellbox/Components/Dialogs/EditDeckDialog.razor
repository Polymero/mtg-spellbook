
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            Edit Deck
        </MudText>
    </TitleContent>

    <DialogContent>

        <MudStack Spacing="2">

            <MudPaper Outlined="true"
                      Class="px-4 py-2">
                <MudTextField @bind-Value="_editDto.Name"
                              Label="Name" 
                              Required="true"
                              Immediate="true"
                              Typo="Typo.h5" />
            </MudPaper>

            <MudPaper Outlined="true"
                      Class="px-4 py-2">
                <MudSelect T="DeckType"
                           Label="Type"
                           @bind-Value="_editDto.Type">
                    @foreach (var v in Enum.GetValues<DeckType>())
                    {
                        <MudSelectItem Value="v">
                            @v
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>

            <MudPaper Outlined="true"
                      Class="px-4 py-2">
                <MudTextField @bind-Value="_editDto.Description" 
                            Label="Description" 
                            Lines="3"
                            Immediate="true"
                            ShrinkLabel="true" />
            </MudPaper>

            <MudPaper Outlined="true"
                      Class="px-4 py-2">
                <MudTextField @bind-Value="_editDto.Tags"
                              Label="Tags" />
            </MudPaper>

            <MudPaper Outlined="true"
                      Class="px-4 py-2">
                <MudTextField @bind-Value="_editDto.Sleeves"
                              Label="Sleeves" />          
            </MudPaper>

            <MudPaper Outlined="true"
                      Class="px-4 py-2">

                <MudText Typo="Typo.caption">
                    Cover Images
                </MudText>

                @foreach (var id in _editDto.CoverImages)
                {
                    <MudStack Row="true" 
                              StretchItems="StretchItems.Start">
                        <MudText>@id</MudText>

                        <MudIconButton @onclick="@(() => _editDto.CoverImages.Remove(id))"
                                       Icon="@Icons.Material.Filled.Remove"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small" />
                    </MudStack>
                }

                <MudStack Row="true">

                    <MudContainer Gutters="false">
                        <CardSearchComponent OnSelectFunc="@((_viewer) => _selectedVariantId = _viewer.Variant.ScryfallId)"/>
                    </MudContainer>

                    <MudIconButton @onclick="@(() => _editDto.CoverImages.Add(_selectedVariantId!.Value))"
                                   Icon="@Icons.Material.Filled.Add"
                                   Variant="Variant.Outlined"
                                   Color="Color.Tertiary"
                                   Size="Size.Small"
                                   Class="mt-4"
                                   Disabled="@(_selectedVariantId is null)" />
                </MudStack>
            </MudPaper>

            <MudContainer Gutters="false">
                <CollectionDeckCard Deck="_editDto.Preview" />
            </MudContainer>

        </MudStack>

    </DialogContent>

    <DialogActions>
        <MudButton Class="mx-2 my-1"
                   Color="Color.Error"
                   Variant="Variant.Outlined"
                   OnClick="DeleteAsync"
                   StartIcon="@Icons.Material.Filled.DeleteForever">
            Delete
        </MudButton>

        <MudButton Class="mx-2 my-1"
                   Color="Color.Warning"
                   Variant="Variant.Outlined"
                   OnClick="TransformAsync">
            To Binder           
        </MudButton>

        <MudSpacer />

        <MudButton Class="mx-2 my-1"
                   Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Class="mx-2 my-1"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync">
            Save Changes
        </MudButton>
    </DialogActions>

</MudDialog>


@inject CollectionService CollectionService
@inject CrossService CrossService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid DeckId { get; set; }

    private EditableDeckDto _editDto = null!;
    private Guid? _selectedVariantId = null;

    protected override async Task OnParametersSetAsync()
    {
        _editDto = await CollectionService.GetEditableDeckAsync(DeckId);
    }


    private async Task SaveAsync()
    {
        var updatedDto = await CollectionService.UpdateDeckAsync(_editDto);
        await CrossService.RefreshDeckPropertiesAsync(_editDto.Id);
        MudDialog.Close(DialogResult.Ok(new EditDeckCallback(
            updatedDto,
            false,
            true,
            false
        )));

        Snackbar.Add($"Changes saved successfully ~ !", Severity.Success);
    }

    private async Task DeleteAsync()
    {
        await CollectionService.DeleteDeckAsync(_editDto.Id);
        MudDialog.Close(DialogResult.Ok(new EditDeckCallback(
            new DeckDto
            {
                Id = _editDto.Id
            },
            false,
            false,
            true
        )));

        Snackbar.Add($"Deck '{_editDto.Name}' deleted.", Severity.Success);
    }

    private async Task TransformAsync()
    {
        var binder = await CollectionService.TransformDeckIntoBinderAsync(_editDto);
        MudDialog.Close(DialogResult.Ok(new EditDeckCallback(
            new DeckDto
            {
                Id = _editDto.Id
            },
            false,
            false,
            true,
            Transformed: binder
        )));
    }


    private void Cancel() => MudDialog.Cancel();

}
