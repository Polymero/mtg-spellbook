@using MudBlazor.Charts

<MudDialog Class="border-2 mud-border-dark">

    <DialogContent>

        @if (_viewerDto is null)
        {
            <MudProgressCircular Indeterminate />
        }
        else
        {

            <MudGrid>

                <!-- Card image -->
                <MudItem xs="5"
                         Class="my-4">
                    <MudImage Src=@(_viewerDto.Variant.Images.Front.Large) 
                              Alt="IMG" 
                              Fluid="true"
                              Style="border-radius: 5%;"/>
                </MudItem>

                <!-- Card data -->
                <MudItem xs="7">

                    <MudText Typo="Typo.h4"
                            Class="pt-4 pb-6">
                        @_viewerDto.Oracle.Name
                    </MudText>

                    <MudText Typo="Typo.h6"
                            Class="mb-1">
                        Oracle Info
                    </MudText>

                    @foreach (var f in _viewerDto.Faces.OrderBy(f => f.Order))
                    {
                        <MudPaper Class="pa-2 mb-2" 
                                  Elevation="0" 
                                  Outlined="true">

                            <!-- Card name -->
                            <MudText Typo="Typo.subtitle1" 
                                     Class="">
                                @f.Name @SymbologyService.RenderSymbolText(f.ManaCost)
                            </MudText>

                            <MudDivider Class="my-1" />

                            <!-- Type line -->
                            <MudText Typo="Typo.caption">
                                @f.TypeLine
                            </MudText>

                            <MudDivider Class="my-1" />

                            <!-- Oracle text -->
                            <MudText Typo="Typo.body2" 
                                     Class="my-2"
                                     Style="white-space: pre-line;">
                                @SymbologyService.RenderSymbolText(f.OracleText)
                            </MudText>

                            <!-- Flavor text, if any -->
                            @if (VariantId.HasValue && _viewerDto.Variant.FlavorTexts is not null)
                            {
                                <MudText Typo="Typo.body2"
                                         Class="my-2"
                                         Style="white-space: pre-line;">
                                    <i>@_viewerDto.Variant.FlavorTexts[f.Order]</i>
                                </MudText>
                            }

                            <!-- Power and toughness, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Power))
                            {
                                <MudDivider Class="my-1" />

                                <MudChip T="string"
                                         Size="Size.Small">
                                    <MudText Typo="Typo.subtitle1">
                                        <b>@String.Format("{0} / {1}", f.Power, f.Toughness)</b>
                                    </MudText>
                                </MudChip>
                            }
                            
                            <!-- Defense, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Defense))
                            {
                                <MudDivider Class="my-1" />

                                <MudChip T="string"
                                         Size="Size.Small">
                                    <MudText Typo="Typo.subtitle1">
                                        <b>@f.Defense</b>
                                    </MudText>
                                </MudChip>
                            }

                            <!-- Loyalty, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Loyalty))
                            {
                                <MudDivider Class="my-1" />

                                <MudChip T="string"
                                         Size="Size.Small">
                                    <MudText Typo="Typo.subtitle1">
                                        <b>@f.Loyalty</b>
                                    </MudText>
                                </MudChip>
                            }

                        </MudPaper>
                    }

                    <!-- Legalities data -->
                    <MudText Typo="Typo.h6"
                             Class="mt-6">
                        Legalities
                    </MudText>

                    <MudPaper Class="pa-2 mb-1" 
                                Elevation="0" 
                                Outlined="false">

                        @{var _legalityColours = new List<MudBlazor.Color> {Color.Default, Color.Success, Color.Warning, Color.Error};}

                        @foreach (var format in _viewerDto.Oracle.Legalities.GetType().GetProperties())
                        {
                            <MudChip T="string" 
                                     Variant="Variant.Outlined"
                                     Size="Size.Small"
                                     Label="true"
                                     Color="@_legalityColours[(int) @format.GetValue(_viewerDto.Oracle.Legalities)!]">
                                @format.Name 
                            </MudChip>
                        }

                    </MudPaper>

                    <!-- Additional variant data -->
                    @if (VariantId.HasValue)
                    {
                        <MudText Typo="Typo.h6"
                                 Class="mt-6">
                            Variant Info
                        </MudText>

                        <MudPaper Class="pa-2 mb-1" 
                                  Elevation="0" 
                                  Outlined="false">

                            <MudStack Row="true">

                                <MudStack Spacing="0" 
                                          AlignItems="AlignItems.End">
                                    <MudText><b>Set</b></MudText>
                                    <MudText><b>Rarity</b></MudText>
                                    <MudText><b>Released</b></MudText>
                                    <MudText><b>Artist</b></MudText>
                                </MudStack>

                                <MudStack Spacing="0">
                                    <MudText>@_viewerDto.Variant.SetName (@_viewerDto.Variant.SetCode.ToUpper() @_viewerDto.Variant.CollNum)</MudText>
                                    <MudText Style="text-transform: capitalize">@_viewerDto.Variant.Rarity</MudText>
                                    <MudText>@_viewerDto.Variant.Released</MudText>
                                    <MudText>@_viewerDto.Variant.Artist</MudText>
                                </MudStack>

                            </MudStack>

                        </MudPaper>
                    }

                </MudItem>

            </MudGrid>

            <!-- Collection Actions -->
            <MudText Typo="Typo.h6"
                     Class="pt-4">
                Card Allocations
            </MudText>

            <MudTable Items="_viewerDto.Allocations"
                      Dense="true"
                      Hover="true"
                      Elevation="0">
            
                <HeaderContent>
                    <MudTh>Location</MudTh>
                    <MudTh>Set Code</MudTh>
                    <MudTh>Finish</MudTh>
                    <MudTh>Language</MudTh>
                    <MudTh>Condition</MudTh>
                    <MudTh>Flags</MudTh>
                    <MudTh>Bought</MudTh>
                    <MudTh>Price</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate Context="a">
                    <MudTd>
                        @if (a.BinderName is not null) { @a.BinderName }
                        else if (a.DeckName is not null) { @a.DeckName }
                        else { <MudText Typo="Typo.caption"><i>Unassigned</i></MudText> }
                    </MudTd>
                    <MudTd>
                        @String.Format("{0} {1}", _variantInfo[a.VariantId].SetCode.ToUpper(), _variantInfo[a.VariantId].CollNum)
                    </MudTd>
                    <MudTd>
                        @if (a.Finish == CardFinish.NonFoil) { <MudIcon Icon="@Icons.Material.Rounded.StarBorder" Title="NonFoil" /> }
                        else if (a.Finish == CardFinish.Foil) { <MudIcon Icon="@Icons.Material.Rounded.Star" Title="Foil" /> }
                        else { @a.Finish }
                    </MudTd>
                    <MudTd>
                        @a.Language
                    </MudTd>
                    <MudTd>
                        @switch (a.Condition)
                        {
                            case CardCondition.Mint:
                                <MudChip T="string" Label="true" Size="Size.Small"><b>MT</b></MudChip>
                                break;
                            case CardCondition.NearMint:
                                <MudChip T="string" Label="true" Size="Size.Small"><b>NM</b></MudChip>
                                break;
                            case CardCondition.Excellent:
                                <MudChip T="string" Label="true" Size="Size.Small"><b>EX</b></MudChip>
                                break;
                            case CardCondition.Good:
                                <MudChip T="string" Label="true" Size="Size.Small"><b>GD</b></MudChip>
                                break;
                            case CardCondition.LightPlayed:
                                <MudChip T="string" Label="true" Size="Size.Small"><b>LP</b></MudChip>
                                break;
                            case CardCondition.Played:
                                <MudChip T="string" Label="true" Size="Size.Small"><b>PL</b></MudChip>
                                break;
                            case CardCondition.Poor:
                                <MudChip T="string" Label="true" Size="Size.Small"><b>PO</b></MudChip>
                                break;
                            default:
                                <MudChip T="string" Label="true" Size="Size.Small"><b>—</b></MudChip>
                                break;
                        }
                    </MudTd>
                    <MudTd>
                        @if (a.IsAltered) { <MudIcon Icon="@Icons.Material.Filled.Filter" Title="Altered" /> }
                        @if (a.IsSigned) { <MudIcon Icon="@Icons.Material.Filled.Draw" Title="Signed" /> }
                        @if (a.IsStamped) { <MudIcon Icon="@Icons.Material.Filled.Bookmark" Title="Stamped" /> }
                    </MudTd>
                    <MudTd Style="text-align: center">
                        @if (a.BoughtFor.HasValue)
                        {
                            @if (a.Price.HasValue && a.Price.Value > 0m && a.BoughtFor > 0m)
                            {
                                var shift = 100 * (a.Price.Value - a.BoughtFor.Value) / a.BoughtFor.Value;

                                @if (shift < 0m) { <span>€@a.BoughtFor.Value.ToString("0.00") <MudText Typo="Typo.caption" Color="Color.Error">(@shift.ToString("0.0")%)</MudText></span> }
                                else { <span>€@a.BoughtFor.Value.ToString("0.00") <MudText Typo="Typo.caption" Color="Color.Success">(+@shift.ToString("0.0")%)</MudText></span> }
                            }
                            else { <span>€@a.BoughtFor.Value.ToString("0.00")</span> }
                        }
                        else { <span>—</span> }
                    </MudTd>
                    <MudTd>
                        @if (a.Price.HasValue) { <span>€@a.Price.Value.ToString("0.00")</span> }
                        else { <span>—</span> }
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small" 
                                       OnClick="@(() => EditAllocationAsync(a.Id))" />
                    </MudTd>
                </RowTemplate>
            
            </MudTable>

        }

    </DialogContent>

</MudDialog>


@inject CrossService CrossService
@inject IDialogService DialogService
@inject OracleService OracleService
@inject SymbologyService SymbologyService
@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid? VariantId { get; set; } = null;
    [Parameter] public List<CollectionAllocationDto> Allocations { get; set; } = [];
    [Parameter] public EventCallback<EditAllocationCallback> OnEditSuccess { get; set; }


    private CardDetailsViewerDto _viewerDto = new();
    private Dictionary<Guid, CardVariantDto> _variantInfo = new();
    
    protected override async Task OnParametersSetAsync()
    {
        if (!VariantId.HasValue)
            return;

        _viewerDto = await CrossService.GetCardDetailsViewerDtoAsync(VariantId.Value);
        _viewerDto.Allocations = Allocations;

        _variantInfo = await OracleService.GetVariantsByIdsAsync(Allocations
            .Select(a => a.VariantId)
            .Distinct()
            .ToList());

        StateHasChanged();
    }


    private async Task EditAllocationAsync(Guid allocationId)
    {
        var parameters = new DialogParameters
        {
            ["AllocationId"] = allocationId
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<EditAllocationDialog>("Edit Allocation", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is EditAllocationCallback callback)
        {
            if (callback.IsUpdated)
            {
                var index = _viewerDto.Allocations
                    .FindIndex(a => a.Id == callback.Allocation.Id);

                if (index >= 0)
                    _viewerDto.Allocations[index] = callback.Allocation;
            }

            if (callback.IsDeleted)
            {
                _viewerDto.Allocations.RemoveAll(a => a.Id == callback.Allocation.Id);

                if (_viewerDto.Allocations.Count == 0)
                    {
                        MudDialog.Close(DialogResult.Ok(callback));
                        return;
                    }
            }

            StateHasChanged();
            await OnEditSuccess.InvokeAsync(callback);
        }
    }


    private void Cancel() => MudDialog.Cancel();

}
