
<MudDialog>

    <DialogContent>

        @if (_viewerDto is null)
        {
            <MudProgressCircular Indeterminate />
        }
        else
        {

            <MudText Typo="Typo.h4"
                     Class="py-2">
                @_viewerDto.Oracle.Name
            </MudText>

            <MudGrid Class="mt-0">

                <!-- Card image -->
                <MudItem xs="5"
                         Class="my-auto">
                    <MudImage Src=@(_viewerDto.Variant.Images[0]) 
                              Alt="IMG" 
                              Fluid="true"
                              Style="border-radius: 5%;"/>
                </MudItem>

                <!-- Card data -->
                <MudItem xs="7">

                    <MudText Typo="Typo.h6"
                             Class="mb-1">
                        Info
                    </MudText>

                    @foreach (var f in _viewerDto.Faces.OrderBy(f => f.Order))
                    {
                        <MudPaper Class="pa-2 mb-2" 
                                  Elevation="0" 
                                  Outlined="true">

                            <!-- Card name -->
                            <MudText Typo="Typo.subtitle1" 
                                     Class="font-weight-bold">
                                @f.Name
                            </MudText>

                            <MudDivider Class="my-1" />

                            <!-- Type line -->
                            <MudText Typo="Typo.caption">
                                @f.TypeLine
                            </MudText>

                            <MudDivider Class="my-1" />

                            <!-- Oracle text -->
                            <MudText Typo="Typo.body2" 
                                     Class="my-2"
                                     Style="white-space: pre-line;">
                                @f.OracleText
                            </MudText>

                            <!-- Flavor text, if any -->
                            @if (VariantId.HasValue && _viewerDto.Variant.FlavorTexts is not null)
                            {
                                <MudText Typo="Typo.body2"
                                         Class="my-2"
                                         Style="white-space: pre-line;">
                                    <i>@_viewerDto.Variant.FlavorTexts[f.Order]</i>
                                </MudText>
                            }

                            <!-- Power and toughness, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Power))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @String.Format("{0}/{1}", f.Power, f.Toughness)
                                </MudText>
                            }
                            
                            <!-- Defense, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Defense))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @f.Defense
                                </MudText>
                            }

                            <!-- Loyalty, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Loyalty))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @f.Loyalty
                                </MudText>
                            }

                        </MudPaper>
                    }

                    <!-- Additional variant data -->
                    @if (VariantId.HasValue)
                    {
                        <MudPaper Class="pa-2 mb-2"
                                Elevation="0">

                            <!-- Set -->
                            <MudText Typo="Typo.body1">
                                <b>Set:</b> @_viewerDto.Variant.SetName (@_viewerDto.Variant.SetCode.ToUpper() @_viewerDto.Variant.CollNum)
                            </MudText>

                            <!-- Rarity -->
                            <MudText Typo="Typo.body1"
                                    Style="text-transform: capitalize">
                                <b>Rarity:</b> @_viewerDto.Variant.Rarity
                            </MudText>

                            <!-- Release date -->
                            <MudText Typo="Typo.body1">
                                <b>Released:</b> @_viewerDto.Variant.Released
                            </MudText>

                            <!-- Artist -->
                            <MudText Typo="Typo.body1">
                                <b>Artist:</b> @_viewerDto.Variant.Artist
                            </MudText>

                        </MudPaper>
                    }

                </MudItem>

            </MudGrid>

            <!-- Collection Actions -->
            <MudText Typo="Typo.h6"
                     Class="pt-4">
                Card Allocations
            </MudText>

            <MudTable Items="_viewerDto.Allocations"
                      Dense="true"
                      Hover="true"
                      Elevation="0">
            
                <HeaderContent>
                    <MudTh>
                        Allocation
                    </MudTh>
                    <MudTh>
                        Finish
                    </MudTh>
                    <MudTh>
                        Language
                    </MudTh>
                    <MudTh>
                        Condition
                    </MudTh>
                    <MudTh>
                        Flags
                    </MudTh>
                    <MudTh>
                        Bought
                    </MudTh>
                    <MudTh>
                        Price
                    </MudTh>
                    <MudTh>
                    
                    </MudTh>
                </HeaderContent>

                <RowTemplate Context="a">
                    <MudTh>
                        @if (a.BinderName is not null)
                        {
                            @a.BinderName
                        }
                        else if (a.DeckName is not null)
                        {
                            @a.DeckName
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">
                                <i>Unassigned</i>
                            </MudText>
                        }
                    </MudTh>
                    <MudTh>
                        @if (a.Finish == CardFinish.NonFoil)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.StarBorder" Title="NonFoil" />
                        }
                        else if (a.Finish == CardFinish.Foil)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.Star" Title="Foil" />
                        }
                        else
                        {
                            @a.Finish
                        }
                    </MudTh>
                    <MudTh>
                        @a.Language
                    </MudTh>
                    <MudTh>
                        @a.Condition
                    </MudTh>
                    <MudTh>
                        @if (a.IsAltered)
                        {
                            <MudText Typo="Typo.caption">
                                Alt
                            </MudText>
                        }
                        @if (a.IsSigned)
                        {
                            <MudText Typo="Typo.caption">
                                Sig
                            </MudText>
                        }
                    </MudTh>
                    <MudTh>
                        @if (a.BoughtFor.HasValue)
                        {
                            @if (_priceCache.TryGetValue(a.Id, out var price) &&
                                 price.HasValue && price.Value > 0m && a.BoughtFor > 0m)
                            {
                                var shift = 100 * (price.Value - a.BoughtFor.Value) / a.BoughtFor.Value;

                                @if (shift < 0m)
                                {
                                    <span>
                                        €@a.BoughtFor.Value.ToString("0.00") <MudText Typo="Typo.caption" Color="Color.Error">(@shift.ToString("0.0")%)</MudText>
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        €@a.BoughtFor.Value.ToString("0.00") <MudText Typo="Typo.caption" Color="Color.Success">(+@shift.ToString("0.0")%)</MudText>
                                    </span>
                                }
                            }
                            else
                            {
                                <span>
                                    €@a.BoughtFor.Value.ToString("0.00")
                                </span>
                            }
                        }
                        else
                        {
                            <span>
                                —
                            </span>
                        }
                    </MudTh>
                    <MudTh>
                        @if (!_priceCache.TryGetValue(a.Id, out var price))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate />
                        }
                        else
                        {
                            @if (price.HasValue)
                            {
                                <span>
                                    €@price.Value.ToString("0.00")
                                </span>
                            }
                            else
                            {
                                <span>
                                    —
                                </span>
                            }
                        }
                    </MudTh>
                    <MudTh>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small" 
                                       OnClick="@(() => EditAllocationAsync(a.Id))" />
                    </MudTh>
                </RowTemplate>
            
            </MudTable>

        }

    </DialogContent>

</MudDialog>


@inject CrossService CrossService
@inject IDialogService DialogService
@inject IPricingRouter PricingRouter
@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid? OracleId { get; set; } = null;
    [Parameter]
    public Guid? VariantId { get; set; } = null;
    [Parameter]
    public Guid? BinderId { get; set; } = null;
    [Parameter]
    public Guid? SnapshotId { get; set; } = null;
    [Parameter]
    public EventCallback<EditCallback> OnEditSuccess { get; set; }


    private CardDetailsViewerDto _viewerDto = new();
    private Dictionary<Guid, decimal?> _priceCache = new Dictionary<Guid, decimal?>();
    
    protected override async Task OnParametersSetAsync()
    {
        if (OracleId is null && VariantId is null)
            return;

        _viewerDto = await CrossService.GetCardDetailsViewerDtoAsync(OracleId, VariantId, BinderId, SnapshotId);

        _priceCache.Clear();
        _priceCache = await PricingRouter.GetPriceBatchAsync(_viewerDto.Allocations);

        StateHasChanged();
    }


    private async Task EditAllocationAsync(Guid allocationId)
    {
        var parameters = new DialogParameters
        {
            ["AllocationId"] = allocationId
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<EditAllocationDialog>("Edit Allocation", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is EditCallback callback)
        {
            if (callback.IsUpdated)
            {
                ;
            }

            if (callback.IsDeleted)
            {
                ;
            }

            StateHasChanged();
            await OnEditSuccess.InvokeAsync(callback);
        }
    }


    private void Cancel() => MudDialog.Cancel();

}
