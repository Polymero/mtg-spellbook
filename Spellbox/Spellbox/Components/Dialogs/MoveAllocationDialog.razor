

<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            Moving @AllocationIds.Count Cards
        </MudText>
    </TitleContent>

    <DialogContent>

        <TargetSelectionComponent BinderCache="_binders"
                                  DeckCache="_decks"
                                  TargetBinder="_targetBinder"
                                  TargetDeck="_targetDeck"
                                  TargetZoneType="_targetZoneType"/>

    </DialogContent>

    <DialogActions>

        <MudSpacer />

        <MudButton Class="mx-2 my-1"
                   Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Class="mx-2 my-1"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   Disabled="@(!CanMove)"
                   OnClick="MoveAsync">
            Move
        </MudButton>

    </DialogActions>

</MudDialog>


@inject CollectionService CollectionService
@inject CrossService CrossService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public HashSet<Guid> AllocationIds { get; set; } = new();
    [Parameter] public Guid? CurrentBinderId { get; set; }
    [Parameter] public Guid? CurrentZoneId { get; set; }

    private CollectionBinderDto? _targetBinder;
    private DeckDto? _targetDeck;
    private DeckZoneType _targetZoneType = DeckZoneType.Mainboard;

    private List<CollectionBinderDto> _binders = new List<CollectionBinderDto>();
    private List<DeckDto> _decks = new List<DeckDto>();

    private bool CanMove =>
        !(
            _targetBinder is not null && 
            _targetDeck is not null
        );


    protected override async Task OnParametersSetAsync()
    {
        _binders = await CollectionService.GetAllBinders();
        _decks = await CollectionService.GetAllDecks();

        _targetBinder = CurrentBinderId.HasValue 
            ? _binders.Single(b => b.Id == CurrentBinderId.Value) 
            : null;
        _targetDeck = CurrentZoneId.HasValue 
            ? _decks.Single(d => d.ActiveZoneIds.Values.Contains(CurrentZoneId.Value)) 
            : null;
    }


    private async Task MoveAsync()
    {
        var movedIds = await CrossService.MoveAllocationsAsync(AllocationIds, _targetBinder?.Id, _targetDeck?.Id, _targetZoneType);
        
        var targetName = "Unassigned";
        if (_targetBinder is not null)
            targetName = _targetBinder.Name;
        else if (_targetDeck is not null)
            targetName = _targetDeck.Name;

        Snackbar.Add($"Moved {movedIds.Count} card(s) to '{targetName}.'", Severity.Success);

        MudDialog.Close(DialogResult.Ok(new MoveAllocationsCallback(movedIds.AsEnumerable())));
    }





    private void Cancel() => MudDialog.Cancel();

}
