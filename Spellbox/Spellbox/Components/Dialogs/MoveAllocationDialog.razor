

<MudDialog>

    <TitleContent>

        <MudText Typo="Typo.h6">
            Moving @AllocationIds.Count Cards
        </MudText>

    </TitleContent>

    <DialogContent>

        <TargetSelectionComponent BinderCache="_binders"
                                  DeckCache="_decks"
                                  @bind-State="_selectionState" />

    </DialogContent>

    <DialogActions>

        <MudSpacer />

        <MudButton Class="mx-2 my-1"
                   Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Class="mx-2 my-1"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   Disabled="@(!CanMove)"
                   OnClick="MoveAsync">
            Move
        </MudButton>

    </DialogActions>

</MudDialog>


@inject CollectionService CollectionService
@inject CrossService CrossService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public HashSet<Guid> AllocationIds { get; set; } = new();
    [Parameter] public Guid? CurrentBinderId { get; set; }
    [Parameter] public Guid? CurrentZoneId { get; set; }

    private TargetSelectionComponent.ComponentState _selectionState = new(); 

    private List<CollectionBinderDto> _binders = new List<CollectionBinderDto>();
    private List<DeckDto> _decks = new List<DeckDto>();

    private bool CanMove =>
        !(
            _selectionState.TargetBinder is not null && 
            _selectionState.TargetDeck is not null
        );


    protected override async Task OnParametersSetAsync()
    {
        _binders = await CollectionService.GetAllBinders();
        _decks = await CollectionService.GetAllDecks();

        _selectionState.TargetBinder = CurrentBinderId.HasValue 
            ? _binders.Single(b => b.Id == CurrentBinderId.Value) 
            : null;
        _selectionState.TargetDeck = CurrentZoneId.HasValue 
            ? _decks.Single(d => d.ActiveZoneIds.Values.Contains(CurrentZoneId.Value)) 
            : null;
    }


    private async Task MoveAsync()
    {
        var movedIds = await CrossService.MoveAllocationsAsync(
            AllocationIds, 
            _selectionState.TargetBinder?.Id, 
            _selectionState.TargetDeck?.Id, 
            _selectionState.TargetZoneType
        );
        
        var targetName = "Unassigned";
        if (_selectionState.TargetBinder is not null)
            targetName = _selectionState.TargetBinder.Name;
        else if (_selectionState.TargetDeck is not null)
            targetName = _selectionState.TargetDeck.Name;

        Snackbar.Add($"Moved {movedIds.Count} card(s) to '{targetName}.'", Severity.Success);

        MudDialog.Close(DialogResult.Ok(new MoveAllocationsCallback(movedIds.AsEnumerable())));
    }


    private void Cancel() => MudDialog.Cancel();

}
