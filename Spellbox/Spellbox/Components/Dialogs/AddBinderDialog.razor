@using Spellbox.Model

<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            Add Binder
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField @bind-Value="binderName"
                      Label="Name" 
                      Required="true"
                      Immediate="true"
                      Typo="Typo.h5" />

        <MudTextField @bind-Value="binderDescription" 
                      Label="Description" 
                      Lines="3"
                      Immediate="true"
                      AutoGrow />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Success" 
                   OnClick="SaveBinder" 
                   Disabled="@string.IsNullOrWhiteSpace(binderName)">
            Add
        </MudButton>
    </DialogActions>

</MudDialog>


@inject IDbContextFactory<CollectionDbContext> CollectionDbFactory
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    private string binderName { get; set; } = string.Empty;
    private string binderDescription { get; set; } = string.Empty;


    private async Task SaveBinder()
    {
        using var db = await CollectionDbFactory.CreateDbContextAsync();

        var binder = new CollectionBinder
        {
            Id = Guid.NewGuid(),
            Name = binderName.Trim(),
            Description = string.IsNullOrWhiteSpace(binderDescription) ? null : binderDescription.Trim(),
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        };

        db.Binders.Add(binder);
        await db.SaveChangesAsync();

        MudDialog.Close(DialogResult.Ok(binder));
        Snackbar.Add("Binder added!", Severity.Success);
    }


    private void Cancel() => MudDialog.Cancel();

}