
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            Add Binder
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField @bind-Value="_newBinder.Name"
                      Label="Name" 
                      Required="true"
                      Immediate="true"
                      Typo="Typo.h5" />

        <MudTextField @bind-Value="_newBinder.Description" 
                      Label="Description" 
                      Lines="3"
                      Immediate="true"
                      AutoGrow />

        <MudTextField @bind-Value="_newBinder.CoverImage"
                      Label="Cover Image" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Success" 
                   OnClick="AddBinder" 
                   Disabled="String.IsNullOrWhiteSpace(_newBinder.Name)">
            Add
        </MudButton>
    </DialogActions>

</MudDialog>


@inject CollectionService CollectionService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    private EditableBinderDto _newBinder = new();


    private async Task AddBinder()
    {
        var newDto = await CollectionService.AddBinderAsync(_newBinder);
        MudDialog.Close(DialogResult.Ok(new EditBinderCallback(
            newDto,
            true,
            false,
            false
        )));

        Snackbar.Add($"Binder '{newDto.Name}' added!", Severity.Success);
    }


    private void Cancel() => MudDialog.Cancel();

}