
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            Edit Binder
        </MudText>
    </TitleContent>

    <DialogContent>

        <MudStack Spacing="2">

            <MudPaper Outlined="true"
                      Class="px-4 py-2">
                <MudTextField @bind-Value="_editDto.Name"
                            Label="Name" 
                            Required="true"
                            Immediate="true"
                            Typo="Typo.h5" />
            </MudPaper>

            <MudPaper Outlined="true"
                      Class="px-4 py-2">
                <MudTextField @bind-Value="_editDto.Description" 
                            Label="Description" 
                            Lines="3"
                            Immediate="true"
                            ShrinkLabel="true" />
            </MudPaper>

            <MudPaper Outlined="true"
                      Class="px-4 py-2">

                <MudText Typo="Typo.caption">
                    Cover Images
                </MudText>

                @foreach (var id in _editDto.CoverImages)
                {
                    <MudStack Row="true" 
                              StretchItems="StretchItems.Start">
                        <MudText>@id</MudText>

                        <MudIconButton @onclick="@(() => _editDto.CoverImages.Remove(id))"
                                       Icon="@Icons.Material.Filled.Remove"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small" />
                    </MudStack>
                }

                <MudStack Row="true">

                    <MudContainer Gutters="false">
                        <CardSearchComponent OnSelectFunc="@((_viewer) => _selectedVariantId = _viewer.Variant.ScryfallId)"/>
                    </MudContainer>

                    <MudIconButton @onclick="@(() => _editDto.CoverImages.Add(_selectedVariantId!.Value))"
                                   Icon="@Icons.Material.Filled.Add"
                                   Variant="Variant.Outlined"
                                   Color="Color.Tertiary"
                                   Size="Size.Small"
                                   Class="mt-4"
                                   Disabled="@(_selectedVariantId is null)" />
                </MudStack>
            </MudPaper>

            <MudContainer Gutters="false">
                <CollectionBinderCard Binder="_editDto.Preview" />
            </MudContainer>

        </MudStack>

    </DialogContent>

    <DialogActions>
        <MudButton Class="mx-2 my-1"
                   Color="Color.Error"
                   Variant="Variant.Outlined"
                   OnClick="DeleteAsync"
                   StartIcon="@Icons.Material.Filled.DeleteForever">
            Delete
        </MudButton>

        <MudButton Class="mx-2 my-1"
                   Color="Color.Warning"
                   Variant="Variant.Outlined"
                   OnClick="TransformAsync">
            To Deck           
        </MudButton>

        <MudSpacer />

        <MudButton Class="mx-2 my-1"
                   Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Class="mx-2 my-1"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync">
            Save Changes
        </MudButton>
    </DialogActions>

</MudDialog>


@inject CollectionService CollectionService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid BinderId { get; set; }

    private EditableBinderDto _editDto = null!;
    private Guid? _selectedVariantId = null;

    protected override async Task OnParametersSetAsync()
    {
        _editDto = await CollectionService.GetEditableBinderAsync(BinderId);
    }


    private async Task SaveAsync()
    {
        var updatedDto = await CollectionService.UpdateBinderAsync(_editDto);
        MudDialog.Close(DialogResult.Ok(new EditBinderCallback(
            updatedDto,
            false,
            true,
            false
        )));

        Snackbar.Add($"Changes saved successfully ~ !", Severity.Success);
    }

    private async Task DeleteAsync()
    {
        await CollectionService.DeleteBinderAsync(_editDto.Id);
        MudDialog.Close(DialogResult.Ok(new EditBinderCallback(
            new CollectionBinderDto
            {
                Id = _editDto.Id
            },
            false,
            false,
            true
        )));

        Snackbar.Add($"Binder '{_editDto.Name}' deleted.", Severity.Success);
    }

    private async Task TransformAsync()
    {
        var deck = await CollectionService.TransformBinderIntoDeckAsync(_editDto);
        MudDialog.Close(DialogResult.Ok(new EditBinderCallback(
            new CollectionBinderDto
            {
                Id = _editDto.Id
            },
            false,
            false,
            true,
            Transformed: deck
        )));
    }


    private void Cancel() => MudDialog.Cancel();

}
