@using Spellbox.Model

<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            Add Deck
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField @bind-Value="_newDeck.Name"
                      Label="Name"
                      Required="true"
                      Immediate="true"
                      Typo="Typo.h5" />


        <MudSelect T="DeckType"
                    Label="Type"
                    @bind-Value="_newDeck.Type">
            @foreach (var v in Enum.GetValues<DeckType>())
            {
                <MudSelectItem Value="v">
                    @v
                </MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_newDeck.Description"
                      Label="Description"
                      Lines="3"
                      Immediate="true"
                      AutoGrow />

        <MudTextField @bind-Value="_newDeck.Sleeves"
                      Label="Sleeves" />

        <MudTextField @bind-Value="_newDeck.CoverImage"
                      Label="Cover Image" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Success"
                   OnClick="AddDeck"
                   Disabled="@string.IsNullOrWhiteSpace(_newDeck.Name)">
            Add
        </MudButton>
    </DialogActions>

</MudDialog>


@inject CollectionService CollectionService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    private EditableDeckDto _newDeck = new();


    private async Task AddDeck()
    {
        var newDto = await CollectionService.AddDeckAsync(_newDeck);
        MudDialog.Close(DialogResult.Ok(new EditDeckCallback(
            newDto,
            true,
            false,
            false
        )));

        Snackbar.Add($"Deck '{newDto.Name}' added!", Severity.Success);
    }


    private void Cancel() => MudDialog.Cancel();

}