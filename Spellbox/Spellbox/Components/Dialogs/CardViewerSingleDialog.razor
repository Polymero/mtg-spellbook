@using Spellbox.Model
@using System.Globalization


<MudDialog>

    <DialogContent>

        @if (_cardDto is null)
        {
            <MudProgressCircular Indeterminate />
        }
        else
        {
            <MudGrid Class="mt-0">

                <!-- Card image -->
                <MudItem xs="5"
                         Class="my-auto">
                    <MudImage Src=@(_cardDto.Images[0]) 
                              Alt="IMG" 
                              Fluid="true"
                              Style="border-radius: 5%;"/>
                </MudItem>

                <!-- Card data -->
                <MudItem xs="7">

                    <MudText Typo="Typo.h6"
                             Class="mb-1">
                        Info
                    </MudText>

                    @foreach (var f in _cardDto!.Faces.OrderBy(f => f.Order))
                    {
                        <MudPaper Class="pa-2 mb-2" 
                                  Elevation="0" 
                                  Outlined="true">

                            <!-- Card name -->
                            <MudText Typo="Typo.subtitle1" 
                                     Class="font-weight-bold">
                                @f.Name
                            </MudText>

                            <MudDivider Class="my-1" />

                            <!-- Type line -->
                            <MudText Typo="Typo.caption">
                                @f.TypeLine
                            </MudText>

                            <MudDivider Class="my-1" />

                            <!-- Oracle text -->
                            <MudText Typo="Typo.body2" 
                                     Class="my-2"
                                     Style="white-space: pre-line;">
                                @f.OracleText
                            </MudText>

                            <!-- Flavor text, if any -->
                            @if (_cardDto.FlavorTexts is not null)
                            {
                                <MudText Typo="Typo.body2"
                                         Class="my-2"
                                         Style="white-space: pre-line;">
                                    <i>@_cardDto.FlavorTexts[f.Order]</i>
                                </MudText>
                            }

                            <!-- Power and toughness, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Power))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @String.Format("{0}/{1}", f.Power, f.Toughness)
                                </MudText>
                            }
                            
                            <!-- Defense, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Defense))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @f.Defense
                                </MudText>
                            }

                            <!-- Loyalty, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Loyalty))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @f.Loyalty
                                </MudText>
                            }

                        </MudPaper>
                    }

                    <!-- Additional variant data -->
                    <MudPaper Class="pa-2 mb-2"
                              Elevation="0">

                        <!-- Set -->
                        <MudText Typo="Typo.body1">
                            <b>Set:</b> @_cardDto.SetName (@_cardDto.SetCode.ToUpper() @_cardDto.CollNum)
                        </MudText>

                        <!-- Rarity -->
                        <MudText Typo="Typo.body1"
                                 Style="text-transform: capitalize">
                            <b>Rarity:</b> @_cardDto.Rarity
                        </MudText>

                        <!-- Release date -->
                        <MudText Typo="Typo.body1">
                            <b>Released:</b> @_cardDto.Released
                        </MudText>

                        <!-- Artist -->
                        <MudText Typo="Typo.body1">
                            <b>Artist:</b> @_cardDto.Artist
                        </MudText>

                    </MudPaper>

                </MudItem>

            </MudGrid>

            <!-- Collection Actions -->
            @* <MudText Typo="Typo.h6"
                     Class="pa-4">
                Actions
            </MudText> *@

            <MudTable Items="Group.Allocations"
                      Dense="true"
                      Hover="true"
                      Elevation="0">
            
                <HeaderContent>
                    <MudTh>
                    
                    </MudTh>
                    <MudTh>
                        Allocation
                    </MudTh>
                    <MudTh>
                        Finish
                    </MudTh>
                    <MudTh>
                        Language
                    </MudTh>
                    <MudTh>
                        Condition
                    </MudTh>
                    <MudTh>
                        Flags
                    </MudTh>
                    <MudTh>
                    
                    </MudTh>
                </HeaderContent>

                <RowTemplate Context="a">
                    <MudTh>
                    
                    </MudTh>
                    <MudTh>
                        @if (a.BinderName is not null)
                        {
                            @a.BinderName
                        }
                        else if (a.DeckName is not null)
                        {
                            @a.DeckName
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">
                                <i>Unassigned</i>
                            </MudText>
                        }
                    </MudTh>
                    <MudTh>
                        @if (a.Finish == CardFinish.NonFoil)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.StarBorder" Title="NonFoil" />
                        }
                        else if (a.Finish == CardFinish.Foil)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.Star" Title="Foil" />
                        }
                        else
                        {
                            @a.Finish
                        }
                    </MudTh>
                    <MudTh>
                        @a.Language
                    </MudTh>
                    <MudTh>
                        @a.Condition
                    </MudTh>
                    <MudTh>
                        @if (a.IsAltered)
                        {
                            <MudText>
                                Alt
                            </MudText>
                        }
                        @if (a.IsSigned)
                        {
                            <MudText>
                                Sig
                            </MudText>
                        }
                    </MudTh>
                    <MudTh>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small" 
                                       OnClick="@(() => Cancel())" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => Cancel())" />
                    </MudTh>
                </RowTemplate>
            
            </MudTable>

        }

    </DialogContent>

    @* <DialogActions>

        <MudButton Color="Color.Error"
                   Variant="Variant.Outlined"
                   OnClick="DeleteAsync">
            Delete
        </MudButton>

        <MudSpacer />

        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync">
            Save
        </MudButton>

    </DialogActions> *@

</MudDialog>


@inject CollectionService CollectionService
@inject OracleService OracleService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public CollectionVariantGroupDto Group { get; set; } = null!;

    private CardViewerDto? _cardDto;


    protected override async Task OnInitializedAsync()
    {
        _cardDto = await OracleService.GetCardInfoByVariantIdAsync(Group.VariantId);
    }


    @* private async Task SaveAsync()
    {
        // await CollectionService.UpdateAllocationAsync(_cardDto!);

        Snackbar.Add("Changes saved!", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }


    private async Task DeleteAsync()
    {
