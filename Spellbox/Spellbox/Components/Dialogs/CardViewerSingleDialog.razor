
<MudDialog>

    <DialogContent>

        @if (_cardDto is null)
        {
            <MudProgressCircular Indeterminate />
        }
        else
        {

            <MudText Typo="Typo.h4"
                     Class="py-2">
                @_cardDto.Name
            </MudText>

            <MudGrid Class="mt-0">

                <!-- Card image -->
                <MudItem xs="5"
                         Class="my-auto">
                    <MudImage Src=@(_cardDto.Images[0]) 
                              Alt="IMG" 
                              Fluid="true"
                              Style="border-radius: 5%;"/>
                </MudItem>

                <!-- Card data -->
                <MudItem xs="7">

                    <MudText Typo="Typo.h6"
                             Class="mb-1">
                        Info
                    </MudText>

                    @foreach (var f in _cardDto!.Faces.OrderBy(f => f.Order))
                    {
                        <MudPaper Class="pa-2 mb-2" 
                                  Elevation="0" 
                                  Outlined="true">

                            <!-- Card name -->
                            <MudText Typo="Typo.subtitle1" 
                                     Class="font-weight-bold">
                                @f.Name
                            </MudText>

                            <MudDivider Class="my-1" />

                            <!-- Type line -->
                            <MudText Typo="Typo.caption">
                                @f.TypeLine
                            </MudText>

                            <MudDivider Class="my-1" />

                            <!-- Oracle text -->
                            <MudText Typo="Typo.body2" 
                                     Class="my-2"
                                     Style="white-space: pre-line;">
                                @f.OracleText
                            </MudText>

                            <!-- Flavor text, if any -->
                            @if (_cardDto.FlavorTexts is not null)
                            {
                                <MudText Typo="Typo.body2"
                                         Class="my-2"
                                         Style="white-space: pre-line;">
                                    <i>@_cardDto.FlavorTexts[f.Order]</i>
                                </MudText>
                            }

                            <!-- Power and toughness, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Power))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @String.Format("{0}/{1}", f.Power, f.Toughness)
                                </MudText>
                            }
                            
                            <!-- Defense, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Defense))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @f.Defense
                                </MudText>
                            }

                            <!-- Loyalty, if any -->
                            @if (!String.IsNullOrWhiteSpace(f.Loyalty))
                            {
                                <MudDivider Class="my-1" />

                                <MudText Typo="Typo.subtitle1"
                                         Class="font-weight-bold">
                                    @f.Loyalty
                                </MudText>
                            }

                        </MudPaper>
                    }

                    <!-- Additional variant data -->
                    <MudPaper Class="pa-2 mb-2"
                              Elevation="0">

                        <!-- Set -->
                        <MudText Typo="Typo.body1">
                            <b>Set:</b> @_cardDto.SetName (@_cardDto.SetCode.ToUpper() @_cardDto.CollNum)
                        </MudText>

                        <!-- Rarity -->
                        <MudText Typo="Typo.body1"
                                 Style="text-transform: capitalize">
                            <b>Rarity:</b> @_cardDto.Rarity
                        </MudText>

                        <!-- Release date -->
                        <MudText Typo="Typo.body1">
                            <b>Released:</b> @_cardDto.Released
                        </MudText>

                        <!-- Artist -->
                        <MudText Typo="Typo.body1">
                            <b>Artist:</b> @_cardDto.Artist
                        </MudText>

                    </MudPaper>

                </MudItem>

            </MudGrid>

            <!-- Collection Actions -->
            <MudText Typo="Typo.h6"
                     Class="pt-4">
                Cards in '@SubcollectionName'
            </MudText>

            <MudTable Items="Group.Allocations"
                      Dense="true"
                      Hover="true"
                      Elevation="0">
            
                <HeaderContent>
                    <MudTh>
                        Allocation
                    </MudTh>
                    <MudTh>
                        Finish
                    </MudTh>
                    <MudTh>
                        Language
                    </MudTh>
                    <MudTh>
                        Condition
                    </MudTh>
                    <MudTh>
                        Flags
                    </MudTh>
                    <MudTh>
                        Bought
                    </MudTh>
                    <MudTh>
                        Price
                    </MudTh>
                    <MudTh>
                    
                    </MudTh>
                </HeaderContent>

                <RowTemplate Context="a">
                    <MudTh>
                        @if (a.BinderName is not null)
                        {
                            @a.BinderName
                        }
                        else if (a.DeckName is not null)
                        {
                            @a.DeckName
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">
                                <i>Unassigned</i>
                            </MudText>
                        }
                    </MudTh>
                    <MudTh>
                        @if (a.Finish == CardFinish.NonFoil)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.StarBorder" Title="NonFoil" />
                        }
                        else if (a.Finish == CardFinish.Foil)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.Star" Title="Foil" />
                        }
                        else
                        {
                            @a.Finish
                        }
                    </MudTh>
                    <MudTh>
                        @a.Language
                    </MudTh>
                    <MudTh>
                        @a.Condition
                    </MudTh>
                    <MudTh>
                        @if (a.IsAltered)
                        {
                            <MudText Typo="Typo.caption">
                                Alt
                            </MudText>
                        }
                        @if (a.IsSigned)
                        {
                            <MudText Typo="Typo.caption">
                                Sig
                            </MudText>
                        }
                    </MudTh>
                    <MudTh>
                        @if (a.BoughtFor.HasValue)
                        {
                            <span>
                                €@a.BoughtFor.Value.ToString("0.00")
                            </span>
                        }
                        else
                        {
                            <span>
                                —
                            </span>
                        }
                    </MudTh>
                    <MudTh>
                        @if (!_priceCache.TryGetValue(a.Id, out var price))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate />
                        }
                        else
                        {
                            @if (price.HasValue)
                            {
                                <span>
                                    €@price.Value.ToString("0.00")
                                </span>
                            }
                            else
                            {
                                <span>
                                    —
                                </span>
                            }
                        }
                    </MudTh>
                    <MudTh>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small" 
                                       OnClick="@(() => EditAsync(a.Id))" />
                    </MudTh>
                </RowTemplate>
            
            </MudTable>

        }

    </DialogContent>

</MudDialog>


@inject IPricingRouter PricingRouter
@inject CollectionService CollectionService
@inject OracleService OracleService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public CollectionVariantGroupDto Group { get; set; } = null!;
    [Parameter]
    public string SubcollectionName { get; set; } = null!;
    [Parameter]
    public EventCallback<EditCallback> OnEditSuccess { get; set; }

    private CardViewerDto? _cardDto;
    private Dictionary<Guid, decimal?> _priceCache = new Dictionary<Guid, decimal?>();


    protected override async Task OnParametersSetAsync()
    {
        if (Group == null)
            return;

        _priceCache.Clear();

        _cardDto = await OracleService.GetCardInfoByVariantIdAsync(Group.VariantId);

        _priceCache = await PricingRouter.GetPriceBatchAsync(Group.Allocations);

        StateHasChanged();
    }


    private async Task EditAsync(Guid allocationId)
    {
        var parameters = new DialogParameters
        {
            ["AllocationId"] = allocationId
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<EditAllocationDialog>("Edit Card", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled &&
            result.Data is EditCallback callback)
        {
            if (callback.IsUpdated)
                await CollectionService.UpdateVariantGroupAsync(Group);

            if (callback.IsDeleted)
            {
                Group.Allocations.RemoveAll(a => a.Id == callback.AllocationId);
                Group.Quantity = Group.Allocations.Count;

                if (Group.Quantity == 0)
                    MudDialog.Close(DialogResult.Ok(callback));
                    return;
            }

            StateHasChanged();

            await OnEditSuccess.InvokeAsync(callback);
        }
    }


    private void Cancel() => MudDialog.Cancel();

}