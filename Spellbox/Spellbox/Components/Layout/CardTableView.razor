@using MudBlazor
@using Spellbox.Components.Dialogs
@using Spellbox.Model
@using System.Collections.ObjectModel

<MudTable Items="_tableRows"
          T="RenderRow"
          Dense="true"
          Hover="true"
          OnRowClick="RowClicked">
          
    @* <ToolBarContent>
        <MudText>
        
        </MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_search"
                      Placeholder="Search..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Small"
                      Class="mt-0"
                      ValueChanged="OnSearch" />
    </ToolBarContent> *@

    <HeaderContent>
        <MudTh>
            Card
        </MudTh>
        <MudTh>
            Variant
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<RenderRow, object>(r => r.Allocation.Finish)">
                Finish
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<RenderRow, object>(r => r.Allocation.Language)">
                Lang
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            Cond
        </MudTh>
        <MudTh>
            Flags
        </MudTh>
        <MudTh>
            Bought
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<RenderRow, object>(r => -r.Allocation.Price ?? 0m)">
                Price
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
        
        </MudTh>
    </HeaderContent>

    <RowTemplate Context="r">
        <MudTd>
            @if (r.Name is not null)
            {
                @r.Name
            }
        </MudTd>
        <MudTd>
            @if (r.Name is not null && r.SetCode is not null && r.CollNum is not null)
            {
                @String.Format("{0} {1}", r.SetCode.ToUpper(), r.CollNum)
            }
        </MudTd>
        <MudTd>
            @if (r.Allocation.Finish == CardFinish.NonFoil)
            {
                <MudIcon Icon="@Icons.Material.Rounded.StarBorder" Title="NonFoil" />
            }
            else if (r.Allocation.Finish == CardFinish.Foil)
            {
                <MudIcon Icon="@Icons.Material.Rounded.Star" Title="Foil" />
            }
            else
            {
                @r.Allocation.Finish
            }
        </MudTd>
        <MudTd>
            @r.Allocation.Language
        </MudTd>
        <MudTd>
            @switch (r.Allocation.Condition)
            {
                case CardCondition.Mint:
                    <MudChip T="string" Label="true" Size="Size.Small"><b>MT</b></MudChip>
                    break;
                case CardCondition.NearMint:
                    <MudChip T="string" Label="true" Size="Size.Small"><b>NM</b></MudChip>
                    break;
                case CardCondition.Excellent:
                    <MudChip T="string" Label="true" Size="Size.Small"><b>EX</b></MudChip>
                    break;
                case CardCondition.Good:
                    <MudChip T="string" Label="true" Size="Size.Small"><b>GD</b></MudChip>
                    break;
                case CardCondition.LightPlayed:
                    <MudChip T="string" Label="true" Size="Size.Small"><b>LP</b></MudChip>
                    break;
                case CardCondition.Played:
                    <MudChip T="string" Label="true" Size="Size.Small"><b>PL</b></MudChip>
                    break;
                case CardCondition.Poor:
                    <MudChip T="string" Label="true" Size="Size.Small"><b>PO</b></MudChip>
                    break;
                default:
                    <MudChip T="string" Label="true" Size="Size.Small"><b>—</b></MudChip>
                    break;
            }
        </MudTd>
        <MudTd>
            @if (r.Allocation.IsAltered)
            {
                <MudIcon Icon="@Icons.Material.Filled.Filter" Title="Altered" />
            }
            @if (r.Allocation.IsSigned)
            {
                <MudIcon Icon="@Icons.Material.Filled.Draw" Title="Signed" />
            }
            @if (r.Allocation.IsStamped)
            {
                <MudIcon Icon="@Icons.Material.Filled.Bookmark" Title="Stamped" />
            }
        </MudTd>
        <MudTd>
            @if (r.Allocation.BoughtFor.HasValue)
            {
                @if (r.Allocation.Price.HasValue && r.Allocation.Price.Value > 0m && r.Allocation.BoughtFor > 0m)
                {
                    var shift = 100 * (r.Allocation.Price.Value - r.Allocation.BoughtFor.Value) / r.Allocation.BoughtFor.Value;

                    @if (shift < 0m) { <span>€@r.Allocation.BoughtFor?.ToString("0.00") <MudText Typo="Typo.caption" Color="Color.Error">(@shift.ToString("0.0")%)</MudText></span> }
                    else { <span>€@r.Allocation.BoughtFor?.ToString("0.00") <MudText Typo="Typo.caption" Color="Color.Success">(+@shift.ToString("0.0")%)</MudText></span> }
                }
                else { <span>€@r.Allocation.BoughtFor.Value.ToString("0.00")</span> }
            }
            else { <span>—</span> }
        </MudTd>
        <MudTd>
            @if (r.Allocation.Price.HasValue) { <span>€@r.Allocation.Price.Value.ToString("0.00")</span> }
            else { <span>—</span> }
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Warning"
                           Size="Size.Small" 
                           OnClick="@(() => EditAsync(r.Allocation.Id))" />
        </MudTd>
    </RowTemplate>

    <PagerContent>
        <MudTablePager PageSizeOptions="new[] {25, 50, 100, 250}" />
    </PagerContent>

</MudTable>


@inject IDialogService DialogService
@inject IPricingRouter PricingRouter
@code {

    [Parameter]
    public IReadOnlyList<CollectionGroupedOracleDto> Groups { get; set; } = null!;
    [Parameter]
    public IReadOnlyDictionary<Guid, CollectionGroupedVariantDto> VariantIndex { get; set; } = null!;
    [Parameter]
    public IReadOnlyDictionary<Guid, CollectionAllocationDto> AllocationIndex { get; set; } = null!;
    [Parameter]
    public EventCallback<EditAllocationCallback> OnEditSuccess { get; set; }

    // UI cache
    private List<RenderRow> _tableRows { get; set; } = [];


    public sealed class RenderRow
    {
        // Oracle-level
        public string Name { get; init; } = null!;

        // Variant-level
        public string SetCode { get; init; } = null!;
        public string CollNum { get; init; } = null!;
        
        // Allocation-level
        public CollectionAllocationDto Allocation { get; init; } = null!;
    }


    protected override void OnParametersSet()
    {
        BuildRows();
    }

    private void BuildRows()
    {
        _tableRows.Clear();

        foreach (var oracleGroup in Groups)
        {
            foreach (var variantGroup in oracleGroup.Variants)
            {
                foreach (var allocation in variantGroup.Allocations)
                {
                    _tableRows.Add(new RenderRow
                    {
                        Name = oracleGroup.Name,

                        SetCode = variantGroup.SetCode,
                        CollNum = variantGroup.CollNum,

                        Allocation = allocation
                    });
                }
            }
        }
    }


    public async Task RowClicked(TableRowClickEventArgs<RenderRow> row)
    {
        if (!VariantIndex.TryGetValue(row.Item!.Allocation.VariantId, out var variantGroup))
            return;

        await OpenCardDialog(variantGroup);
    }

    private async Task OpenCardDialog(CollectionGroupedVariantDto group)
    {
        var parameters = new DialogParameters
        {
            ["VariantId"] = group.VariantId,
            ["Allocations"] = group.Allocations,
            ["OnEditSuccess"] = EventCallback.Factory.Create<EditAllocationCallback>(this, HandleEditSuccess)
        };

        var options = new DialogOptions
        {
            NoHeader = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CardDetailsViewerDialog>("Card Viewer", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled &&
            result.Data is EditAllocationCallback callback)
        {
            await OnEditSuccess.InvokeAsync(callback);
            StateHasChanged();
        }
    }


        private async Task EditAsync(Guid allocationId)
    {
        var parameters = new DialogParameters
        {
            ["AllocationId"] = allocationId
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<EditAllocationDialog>("Edit Card", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled &&
            result.Data is EditAllocationCallback callback)
        {
            StateHasChanged();

            await OnEditSuccess.InvokeAsync(callback);
        }
    }

    private async Task HandleEditSuccess(EditAllocationCallback callback)
    {
        await OnEditSuccess.InvokeAsync(callback);
        StateHasChanged();
    }

}