@using MudBlazor
@using Spellbox.Components.Dialogs
@using Spellbox.Model

<MudTable Items="@_tableRows"
          Dense="true"
          Hover="true"
          T="BinderTableRowDto"
          OnRowClick="RowClicked">

    <HeaderContent>
        <MudTh>
            Card
        </MudTh>
        <MudTh>
            Variant
        </MudTh>
        <MudTh>
            Finish
        </MudTh>
        <MudTh>
            Lang
        </MudTh>
        <MudTh>
            Cond
        </MudTh>
        <MudTh>
            Flags
        </MudTh>
        <MudTh>
            Bought
        </MudTh>
        <MudTh>
            Price
        </MudTh>
        <MudTh>
        
        </MudTh>
    </HeaderContent>

    <RowTemplate Context="r">

        <MudTd>
            @if (r.IsFirst)
            {
                @r.Name
            }
        </MudTd>

        <MudTd>
            @if (r.IsFirst)
            {
                @String.Format("{0} {1}", r.SetCode?.ToUpper(), r.CollNum)
            }
        </MudTd>

        <MudTd>
            @if (r.Allocation.Finish == CardFinish.NonFoil)
            {
                <MudIcon Icon="@Icons.Material.Rounded.StarBorder" Title="NonFoil" />
            }
            else if (r.Allocation.Finish == CardFinish.Foil)
            {
                <MudIcon Icon="@Icons.Material.Rounded.Star" Title="Foil" />
            }
            else
            {
                @r.Allocation.Finish
            }
        </MudTd>

        <MudTd>
            @r.Allocation.Language
        </MudTd>

        <MudTd>
            @r.Allocation.Condition
        </MudTd>

        <MudTd>
            @if (r.Allocation.IsAltered)
            {
                <MudChip T="string" 
                        Variant="Variant.Text"
                        Size="Size.Small">
                    Alt
                </MudChip>
            }

            @if (r.Allocation.IsSigned) 
            {
                <MudChip T="string" 
                        Variant="Variant.Text"
                        Size="Size.Small">
                    Sig
                </MudChip>
            }
            
            @if (r.Allocation.IsStamped)
            {
                <MudChip T="string" 
                        Variant="Variant.Text"
                        Size="Size.Small">
                    Dft
                </MudChip>
            }
        </MudTd>
        <MudTd>
            @if (r.Allocation.BoughtFor.HasValue)
            {
                <span>
                    €@r.Allocation.BoughtFor.Value.ToString("0.00")
                </span>
            }
            else
            {
                <span>
                    —
                </span>
            }
        </MudTd>
        <MudTd>
            @if (!_priceCache.TryGetValue(r.Allocation.Id, out var price))
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate />
                }
                else
                {
                    @if (price.HasValue)
                    {
                        <span>
                            €@price.Value.ToString("0.00")
                        </span>
                    }
                    else
                    {
                        <span>
                            —
                        </span>
                    }
                }
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Warning"
                           Size="Size.Small" 
                           OnClick="@(() => EditAsync(r.Allocation.Id))" />
        </MudTd>

    </RowTemplate>
</MudTable>


@inject IDialogService DialogService
@inject IPricingRouter PricingRouter
@code {

    [Parameter]
    public IReadOnlyList<CollectionVariantGroupDto> Groups { get; set; } = null!;
    [Parameter]
    public string SubcollectionName { get; set; } = null!;
    [Parameter]
    public EventCallback<EditCallback> OnEditSuccess { get; set; }

    // UI cache
    private List<BinderTableRowDto> _tableRows { get; set; } = new List<BinderTableRowDto>();
    private Dictionary<Guid, decimal?> _priceCache = new Dictionary<Guid, decimal?>();


    public sealed class BinderTableRowDto
    {
        public bool IsFirst { get; init; }

        // Variant-level
        public string? Name { get; init; }
        public string? SetCode { get; init; } 
        public string? CollNum { get; init; }
        
        // Copy-level
        public CollectionAllocationDto Allocation { get; init; } = null!;
    }

    private async Task BuildRowsAsync(
        IEnumerable<CollectionVariantGroupDto> groups
    )
    {
        _tableRows.Clear();
        _priceCache.Clear();
    
        var allocs = groups
            .SelectMany(g => g.Allocations)
            .ToList();
            
        _priceCache = await PricingRouter.GetPriceBatchAsync(allocs);

        foreach (var group in groups)
        {
            var first = true;

            foreach (var copy in group.Allocations)
            {
                _tableRows.Add(new BinderTableRowDto
                {
                    IsFirst = first,
                    Name = first ? group.Name : null,
                    SetCode = first ? group.SetCode : null,
                    CollNum = first ? group.CollNum : null,
                    Allocation = copy
                });

                first = false;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await BuildRowsAsync(Groups);
    }


    public async Task RowClicked(TableRowClickEventArgs<BinderTableRowDto> row)
    {
        var group = Groups.Single(g => g.VariantId == row.Item!.Allocation.VariantId);
        await OpenCardDialog(group);
    }


    private async Task OpenCardDialog(CollectionVariantGroupDto group)
    {
        var parameters = new DialogParameters
        {
            ["Group"] = group,
            ["SubcollectionName"] = SubcollectionName,
            ["OnEditSuccess"] = EventCallback.Factory.Create<EditCallback>(this, HandleEditSuccess)
        };

        var options = new DialogOptions
        {
            NoHeader = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CardViewerSingleDialog>("Card Viewer", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled &&
            result.Data is EditCallback callback)
        {
            await OnEditSuccess.InvokeAsync(callback);
            StateHasChanged();
        }
    }


        private async Task EditAsync(Guid allocationId)
    {
        var parameters = new DialogParameters
        {
            ["AllocationId"] = allocationId
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<EditAllocationDialog>("Edit Card", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled &&
            result.Data is EditCallback callback)
        {
            StateHasChanged();

            await OnEditSuccess.InvokeAsync(callback);
        }
    }


    private async Task HandleEditSuccess(EditCallback callback)
    {
        await OnEditSuccess.InvokeAsync(callback);
        StateHasChanged();
    }

}