@using MudBlazor
@using Spellbox.Components.Dialogs
@using Spellbox.Model

<MudTable Items="@TableRows"
          Dense="true"
          Hover="true">

    <HeaderContent>
        <MudTh>
            Card
        </MudTh>
        <MudTh>
            Variant
        </MudTh>
        <MudTh>
            Finish
        </MudTh>
        <MudTh>
            Lang
        </MudTh>
        <MudTh>
            Cond
        </MudTh>
        <MudTh>
            Flags
        </MudTh>
    </HeaderContent>

    <RowTemplate Context="r">

        <MudTd>
            @if (r.IsFirst)
            {
                @r.Name
            }
        </MudTd>

        <MudTd>
            @if (r.IsFirst)
            {
                @String.Format("{0} {1}", r.SetCode?.ToUpper(), r.CollNum)
            }
        </MudTd>

        <MudTd>
            @if (r.Allocation.Finish == CardFinish.NonFoil)
            {
                <MudIcon Icon="@Icons.Material.Rounded.StarBorder" Title="NonFoil" />
            }
            else if (r.Allocation.Finish == CardFinish.Foil)
            {
                <MudIcon Icon="@Icons.Material.Rounded.Star" Title="Foil" />
            }
            else
            {
                @r.Allocation.Finish
            }
        </MudTd>

        <MudTd>
            @r.Allocation.Language
        </MudTd>

        <MudTd>
            @r.Allocation.Condition
        </MudTd>

        <MudTd>
            @if (r.Allocation.IsAltered)
            {
                <MudChip T="string" 
                        Variant="Variant.Text"
                        Size="Size.Small">
                    Alt
                </MudChip>
            }

            @if (r.Allocation.IsSigned) 
            {
                <MudChip T="string" 
                        Variant="Variant.Text"
                        Size="Size.Small">
                    Sig
                </MudChip>
            }
        </MudTd>

    </RowTemplate>
</MudTable>


@inject IDialogService DialogService
@code {

    [Parameter, EditorRequired]
    public IReadOnlyList<CollectionVariantGroupDto> Groups { get; set; } = null!;
    public IReadOnlyList<BinderTableRowDto> TableRows { get; set; } = null!;


    public sealed class BinderTableRowDto
    {
        public bool IsFirst { get; init; }

        // Variant-level
        public string? Name { get; init; }
        public string? SetCode { get; init; } 
        public string? CollNum { get; init; }
        
        // Copy-level
        public CollectionAllocationDto Allocation { get; init; } = null!;
    }

    private IReadOnlyList<BinderTableRowDto> BuildRows(
        IEnumerable<CollectionVariantGroupDto> groups
    )
    {
        var rows = new List<BinderTableRowDto>();

        foreach (var group in groups)
        {
            var first = true;

            foreach (var copy in group.Allocations)
            {
                rows.Add(new BinderTableRowDto
                {
                    IsFirst = first,
                    Name = first ? group.Name : null,
                    SetCode = first ? group.SetCode : null,
                    CollNum = first ? group.CollNum : null,
                    Allocation = copy
                });

                first = false;
            }
        }

        return rows;
    }

    protected override async Task OnParametersSetAsync()
    {
        TableRows = BuildRows(Groups);
    }


    private async Task OpenCardDialog(Guid allocationId)
    {
        var parameters = new DialogParameters
        {
            ["AllocationId"] = allocationId
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CardViewerSingleDialog>("Card Viewer", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            @* await ReloadBinderAsync(); *@
        }
    }

}