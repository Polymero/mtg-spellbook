

<MudPaper Elevation="1" 
          Class="pa-3 collection-card" 
          Outlined="true">

    <MudStack Row="true" Spacing="3">

        <div class="cover-container">
            <img class="cover-image border-0" 
                 src="@Deck.CoverImage"
                 @onclick="@(() => NavigationManager.NavigateTo($"/decks/{Deck.Id}"))" />
        </div>

        <MudStack Class="flex-grow-1"
                  Spacing="2">

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                <MudStack Spacing="0">

                    <MudLink Typo="Typo.h4"
                             Color="Color.Tertiary"
                             Underline="Underline.None"
                             Href=@String.Format("/decks/{0}", Deck.Id)>
                        <b>@Deck.Name</b>
                    </MudLink>

                    <MudStack Row="true" Spacing="2">
                        <MudText Typo="Typo.caption">
                            <i>(@Deck.Type - @Deck.Quantity cards - last updated: @Deck.UpdatedAt.ToShortDateString())</i>
                        </MudText>

                        <MudText Typo="Typo.caption">
                            @if (Deck.PriceMissing > 0) { <span>€@Deck.PriceValue.ToString("0.00") + @Deck.PriceMissing?</span> }
                            else { <span>€@Deck.PriceValue.ToString("0.00")</span> }
                        </MudText>
                    </MudStack>

                </MudStack>

                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Size="Size.Medium"
                               Color="Color.Inherit"
                               OnClick="OnEditClicked"
                               Class="mt-n8 pa-0" />

            </MudStack>

            <MudText Typo="Typo.body2" Class="mt-0 flex-grow-1">
                @Deck.Description
            </MudText>

            <MudStack Row="true"
                      Spacing="1"
                      AlignItems="AlignItems.Center"
                      Class="mb-n1">

                <MudText Style="font-size: 1.28em;"
                         Class="">
                    @SymbologyService.RenderSymbolText(Deck.ColorIdentity.ToString())
                </MudText>

                @if (Deck.Tags.Count > 0)
                {
                    <MudStack Row="true"
                              Spacing="0"
                              Class="ml-1">
                        @foreach (var tag in Deck.Tags)
                        {
                            <MudChip T="string"
                                    Label="true"
                                    Variant="Variant.Outlined"
                                    Size="Size.Small"
                                    Color="Color.Inherit"
                                    Class="mr-0 pa-1"
                                    Style="height: 22px">
                                <span style="font-size: .7rem">@tag</span>
                            </MudChip>
                        }
                    </MudStack>
                }

                @if (!String.IsNullOrWhiteSpace(Deck.Sleeves))
                {
                    <MudChip T="string"
                             Label="true"
                             Variant="Variant.Text"
                             Color="Color.Primary"
                             Icon="@Icons.Material.Filled.Shield"
                             Size="Size.Small"
                             Class="mud-transparent">
                        @Deck.Sleeves
                    </MudChip>
                }

            </MudStack>

        </MudStack>

    </MudStack>

</MudPaper>


@inject NavigationManager NavigationManager
@inject SymbologyService SymbologyService
@code {

    [Parameter] public DeckDto Deck { get; set; } = null!;
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }

    private async Task OnEditClicked()
    {
        await OnEdit.InvokeAsync(Deck.Id);
    }

}
