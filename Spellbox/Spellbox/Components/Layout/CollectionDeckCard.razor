@using MudBlazor.Charts


<MudPaper Elevation="1" 
          Class="pa-3 collection-card" 
          Outlined="true"
          @onclick="@(() => {})">

    <MudStack Row="true" Spacing="3">

        <div class="cover-container">
            <img class="cover-image" src="@Deck.CoverImage"/>
        </div>

        <!-- Right: Content -->
        <MudStack Class="flex-grow-1">

            <!-- Top Row -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">

                <MudStack Spacing="0">

                    <MudLink Typo="Typo.h4"
                             Href=@String.Format("/decks/{0}", Deck.Id)>
                        @Deck.Name
                    </MudLink>

                    <MudStack Row="true" Spacing="2">
                        <MudText Typo="Typo.caption">
                            <i>(@Deck.Quantity cards - last updated: @Deck.UpdatedAt.ToShortDateString())</i>
                        </MudText>

                        <MudText Typo="Typo.caption">
                            @if (Deck.PriceMissing > 0)
                            {
                                <span>€@Deck.PriceValue.ToString("0.00") + @Deck.PriceMissing?</span>
                            }
                            else
                            {
                                <span>€@Deck.PriceValue.ToString("0.00")</span>
                            }
                        </MudText>
                    </MudStack>

                </MudStack>

                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="OnEditClicked" />

            </MudStack>

            <!-- Bottom Row -->
            <MudText Typo="Typo.body2" Class="mt-2">
                @Deck.Description
            </MudText>

        </MudStack>

    </MudStack>

</MudPaper>


@code {

    [Parameter] public DeckDto Deck { get; set; } = null!;
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }

    private async Task OnEditClicked()
    {
        await OnEdit.InvokeAsync(Deck.Id);
    }

}
