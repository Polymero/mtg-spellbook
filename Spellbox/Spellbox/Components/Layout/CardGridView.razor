

<div class="card-grid-container pa-2" @ref="_containerRef">

    @if (_rows.Count == 0)
    {
        <MudText>No cards to display.</MudText>
    }
    else
    {
        <MudVirtualize Items="_rows"
                       ItemSize="@RowHeight"
                       OverscanCount="3">

            <ChildContent Context="row">
                <div class="card-row" style="grid-template-columns: repeat(@_cardsPerRow, 224px);">
                    @foreach (var group in row)
                    {
                        <MudPaper Class="card-tile" 
                                  Elevation="1"
                                  @onclick="@(() => OpenCardDialog(group))">

                            <MudImage Src="@group.Images[0]"
                                      Alt="img" 
                                      Width="@CardWidth"
                                      Class="card-image"
                                      Style="border-radius: 5%"/>

                            <div class="text-truncate mt-1">
                                <MudChip T="string"
                                         Color="Color.Primary"
                                         Size="Size.Small">
                                    <MudText Typo="Typo.caption">
                                        @String.Format("{0}x", group.Quantity)
                                    </MudText>
                                </MudChip>
                                <MudText Typo="Typo.caption" 
                                         Class="text-truncate">
                                    @group.Name
                                </MudText>
                            </div>

                        </MudPaper>
                    }
                </div>
            </ChildContent>

        </MudVirtualize>
    }

</div>


@inject IDialogService DialogService
@inject IJSRuntime JS
@code {

    [Parameter]
    public IReadOnlyList<CollectionVariantGroupDto> Groups { get; set; } = null!;
    [Parameter]
    public string SubcollectionName { get; set; } = null!;
    [Parameter]
    public EventCallback<EditCallback> OnEditSuccess { get; set; }

    // Constants
    private const int CardWidth = 224;
    private const int CardHeight = (int)(CardWidth / 0.715);
    private const int ColGap = 4;
    private const int RowGap = 20;
    private int RowHeight => CardHeight + RowGap;

    // Rendering
    private ElementReference _containerRef;
    private int _cardsPerRow = 1;
    private List<List<CollectionVariantGroupDto>> _rows = new List<List<CollectionVariantGroupDto>>();
    private IJSObjectReference? _module;
    private IJSObjectReference? _resizeObserver;
    private DotNetObjectReference<CardGridView>? _objRef;


    protected override void OnParametersSet()
    {
        BuildRows();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _resizeObserver is not null)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "../Components/Layout/CardGridView.razor.js?v=1.0.4");

        _objRef = DotNetObjectReference.Create(this);

        await Task.Yield();

        _resizeObserver = await _module.InvokeAsync<IJSObjectReference>(
            "observeResize", _containerRef, _objRef, 150);
    }


    [JSInvokable]
    public async Task OnContainerResize(double width)
    {
        try
        {
            int newColumns = Math.Max(1, (int)Math.Floor(width / (CardWidth + ColGap)));

            if (newColumns != _cardsPerRow)
            {
                _cardsPerRow = newColumns;
                BuildRows();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
        }
    }

    private void BuildRows()
    {
        _rows = Groups
            .Select((card, index) => new { card, index })
            .GroupBy(x => x.index / _cardsPerRow)
            .Select(g => g.Select(x => x.card).ToList())
            .ToList();
    }


    public async ValueTask DisposeAsync()
    {
        if (_resizeObserver is not null)
        {
            await _resizeObserver.InvokeVoidAsync("dispose");
            await _resizeObserver.DisposeAsync();
        }

        if (_objRef is not null)
        {
            _objRef.Dispose();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }


    private async Task OpenCardDialog(CollectionVariantGroupDto group)
    {
        var parameters = new DialogParameters
        {
            ["Group"] = group,
            ["SubcollectionName"] = SubcollectionName,
            ["OnEditSuccess"] = EventCallback.Factory.Create<EditCallback>(this, HandleEditSuccess)
        };

        var options = new DialogOptions
        {
            NoHeader = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CardViewerSingleDialog>("Card Viewer", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled &&
            result.Data is EditCallback callback)
        {
            await OnEditSuccess.InvokeAsync(callback);
            StateHasChanged();
        }
    }

    private async Task HandleEditSuccess(EditCallback callback)
    {
        await OnEditSuccess.InvokeAsync(callback);
        StateHasChanged();
    }

}