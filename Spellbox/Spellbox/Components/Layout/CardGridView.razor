

<div class="card-grid-container pa-2" @ref="_containerRef">

    @if (_rows.Count == 0)
    {
        <MudText>No cards to display.</MudText>
    }
    else
    {
        <MudVirtualize Items="_rows"
                       ItemSize="@RowHeight"
                       OverscanCount="3">

            <ChildContent Context="row">
                <div class="card-row" style="grid-template-columns: repeat(@_cardsPerRow, 224px);">
                    @for (int i = 0; i < _cardsPerRow; i++)
                    {
                        @if (i < row.Count)
                        {
                            <GridCard Card="row[i]" 
                                      OnClick="OpenCardDialog"
                                      OnSelect="SelectCard"
                                      OnDeselect="DeselectCard"
                                      Selection="_selectedAllocations"/>
                        }
                        else
                        {
                            <MudPaper Class="card-tile mb-4" 
                                      Elevation="0"
                                      Style="width: 224px">
                            </MudPaper>
                        }
                    }
                </div>
            </ChildContent>

        </MudVirtualize>
    }

</div>

@if (_selectedAllocations.Count > 0)
{
    <MudPaper Class="@($"gridview-selection-float {(_hiding ? "slide-out" : "")}")"
              Elevation="8">
        <MudPaper Class="px-4 ma-0" Outlined="true">

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.Center"
                      Spacing="2"
                      Class="py-4">

                <MudText>
                    @_selectedAllocations.Count card(s) selected
                </MudText>

                <MudSpacer />

                <MudIconButton Icon="@Icons.Material.Filled.DriveFileMove"
                            Size="Size.Small"
                            OnClick="OpenMoveDialog"
                            Color="Color.Info" />

                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                            Size="Size.Small"
                            OnClick="@(() => _selectedAllocations.Clear())" 
                            Color="Color.Error" />

            </MudStack>

        </MudPaper>
    </MudPaper>
}


@inject IDialogService DialogService
@inject IJSRuntime JS
@code {

    [Parameter] public IReadOnlyList<CollectionGroupedOracleDto> Groups { get; set; } = null!;
    [Parameter] public IReadOnlyDictionary<Guid, CollectionGroupedVariantDto> VariantIndex { get; set; } = null!;
    [Parameter] public IReadOnlyDictionary<Guid, CollectionAllocationDto> AllocationIndex { get; set; } = null!;
    [Parameter] public EventCallback<EditAllocationCallback> OnEditSuccess { get; set; }
    [Parameter] public EventCallback<MoveAllocationsCallback> OnMoveSuccess { get; set; }
    [Parameter] public bool ExpandVariants { get; set; } = false;

    // Constants
    private const int CardWidth = 224;
    private const int CardHeight = (int)(CardWidth / 0.715);
    private const int ColGap = 4;
    private const int RowGap = 20;
    private int RowHeight => CardHeight + RowGap;

    // Rendering
    private ElementReference _containerRef;
    private int _cardsPerRow = 1;
    private List<List<RenderCard>> _rows = new();
    private IJSObjectReference? _module;
    private IJSObjectReference? _resizeObserver;
    private DotNetObjectReference<CardGridView>? _objRef;
    private bool _hiding = false;

    public HashSet<Guid> _selectedAllocations = new ();


    protected override void OnParametersSet()
    {
        BuildRows();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _resizeObserver is not null)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "../Components/Layout/CardGridView.razor.js?v=1.0.4");

        _objRef = DotNetObjectReference.Create(this);

        await Task.Yield();

        _resizeObserver = await _module.InvokeAsync<IJSObjectReference>(
            "observeResize", _containerRef, _objRef, 150);
    }


    [JSInvokable]
    public async Task OnContainerResize(double width)
    {
        try
        {
            int newColumns = Math.Max(1, (int)Math.Floor(width / (CardWidth + ColGap)));

            if (newColumns != _cardsPerRow)
            {
                _cardsPerRow = newColumns;
                BuildRows();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
        }
    }

    private void BuildRows()
    {
        IEnumerable<RenderCard> flatCards;

        if (ExpandVariants)
        {
            flatCards = Groups
                .SelectMany(o => o.Variants
                    .Select(v => new RenderCard
                        {
                            OracleId = o.OracleId,
                            VariantId = v.VariantId,
                            Name = o.Name,
                            Quantity = v.Allocations.Count(),
                            Images = v.Images,
                            Allocations = v.Allocations
                        }));
        }
        else
        {
            flatCards = Groups
                .Select(o =>
                {
                    var allocations = o.Variants
                        .SelectMany(v => v.Allocations)
                        .ToList();

                    var representative = o.Variants
                        .First();

                    return new RenderCard
                    {
                        OracleId = o.OracleId,
                        VariantId = representative.VariantId,
                        Name = o.Name,
                        Quantity = allocations.Count(),
                        Images = representative.Images,
                        Allocations = allocations
                    };
                });
        }

        _rows = flatCards
            .Select((card, index) => new { card, index })
            .GroupBy(x => x.index / _cardsPerRow)
            .Select(g => g.Select(x => x.card).ToList())
            .ToList();
    }


    public async ValueTask DisposeAsync()
    {
        if (_resizeObserver is not null)
        {
            await _resizeObserver.InvokeVoidAsync("dispose");
            await _resizeObserver.DisposeAsync();
        }

        if (_objRef is not null)
        {
            _objRef.Dispose();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }


    private async Task OpenCardDialog(RenderCard card)
    {
        var parameters = new DialogParameters
        {
            ["VariantId"] = card.VariantId,
            ["Allocations"] = card.Allocations,
            ["OnEditSuccess"] = EventCallback.Factory.Create<EditAllocationCallback>(this, HandleEditSuccess)
        };

        var options = new DialogOptions
        {
            NoHeader = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CardDetailsViewerDialog>("Card Viewer", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled &&
            result.Data is EditAllocationCallback callback)
        {
            await OnEditSuccess.InvokeAsync(callback);
            StateHasChanged();
        }
    }

    private async Task HandleEditSuccess(EditAllocationCallback callback)
    {
        await OnEditSuccess.InvokeAsync(callback);
        StateHasChanged();
    }


    private void SelectCard(RenderCard card)
    {
        foreach (var alloc in card.Allocations)
        {
            if (!_selectedAllocations.Contains(alloc.Id))
                _selectedAllocations.Add(alloc.Id);
        }
    }

    private void DeselectCard(RenderCard card)
    {
        foreach (var alloc in card.Allocations)
        {
            if (_selectedAllocations.Contains(alloc.Id))
                _selectedAllocations.Remove(alloc.Id);
        }
    }

    private async Task OpenMoveDialog()
    {
        if (_selectedAllocations.Count == 0)
            return;

        var parameters = new DialogParameters
        {
            ["AllocationIds"] = _selectedAllocations,
            ["CurrentBinderId"] = AllocationIndex[_selectedAllocations.First()].BinderId,
            ["CurrentZoneId"] = AllocationIndex[_selectedAllocations.First()].ZoneId
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<MoveAllocationDialog>("Move Allocations", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled &&
            result.Data is MoveAllocationsCallback callback)
        {
            await OnMoveSuccess.InvokeAsync(callback);

            _selectedAllocations.Clear();
            StateHasChanged();
        }
    }

}