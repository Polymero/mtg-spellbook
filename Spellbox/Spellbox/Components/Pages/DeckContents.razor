@page "/decks/{DeckId:guid}"

@if (_deck == null)
{
    <PageTitle>Spellbox</PageTitle>

    <MudProgressCircular Color="Color.Default" Indeterminate="true"/>
}
else
{

    <MudPaper Class="pa-4">
        
        <MudText Typo="Typo.h4">
            @_deck.Name
        </MudText>

        <MudText Typo="Typo.h6">
            @_deck.Description
        </MudText>

    </MudPaper>

    <MudToggleGroup T="bool"
                    @bind-Value="_expandVariants"
                    Size="Size.Small">
        <MudToggleItem Value="false">
            <MudIcon Icon="@Icons.Material.Filled.ViewModule" />
                Oracle
        </MudToggleItem>
        <MudToggleItem Value="true">
            <MudIcon Icon="@Icons.Material.Filled.Filter1" />
                Variant
        </MudToggleItem>
    </MudToggleGroup>

    <MudPaper Class="pa-4">

        <MudText Typo="Typo.h6">
            Commander(s)
        </MudText>

        <CardGridView Groups="_zones[DeckZoneType.Commanders].Groups"
                      VariantIndex="_zones[DeckZoneType.Commanders].VariantIndex"
                      AllocationIndex="_zones[DeckZoneType.Commanders].AllocationIndex"
                      OnEditSuccess="UpdateCache"
                      ExpandVariants="_expandVariants" />

    </MudPaper>

    <MudPaper Class="pa-4">

        <MudText Typo="Typo.h6">
            Mainboard
        </MudText>

        <CardGridView Groups="_zones[DeckZoneType.Mainboard].Groups"
                      VariantIndex="_zones[DeckZoneType.Mainboard].VariantIndex"
                      AllocationIndex="_zones[DeckZoneType.Mainboard].AllocationIndex"
                      OnEditSuccess="UpdateCache"
                      ExpandVariants="_expandVariants" />

    </MudPaper>


}


@inject CrossService CrossService
@inject CollectionService CollectionService
@code {

    [Parameter]
    public Guid DeckId { get; set; }

    private DeckDto? _deck;
    private Dictionary<DeckZoneType, ZoneDto> _zones = new ();

    private bool _expandVariants = false;

    private sealed class ZoneDto
    {
        public DeckZoneType ZoneType { get; init; }
        public List<CollectionGroupedOracleDto> Groups { get; init; } = [];

        public Dictionary<Guid, CollectionGroupedVariantDto> VariantIndex { get; set; } = new();
        public Dictionary<Guid, CollectionAllocationDto> AllocationIndex { get; set; } = new();
    }


    protected override async Task OnParametersSetAsync()
    {
        _deck = await CollectionService.GetDeckDetails(DeckId);
        var _zoneGroups = await CrossService.GetSnapshotZoneGroupsAsync(_deck.ActiveSnapshotId);

        _zones = _zoneGroups.Select(kvp =>
        {
            var zoneDto = new ZoneDto
            {
                ZoneType = kvp.Key,
                Groups = kvp.Value
            };

            BuildIndexes(zoneDto);

            return new KeyValuePair<DeckZoneType,ZoneDto>(kvp.Key, zoneDto);
        }).ToDictionary();

        StateHasChanged();
    }

    private void BuildIndexes(ZoneDto zone)
    {
        var groups = zone.Groups;
        zone.VariantIndex.Clear();
        zone.AllocationIndex.Clear();

        foreach (var oracle in groups)
        {
            foreach (var variant in oracle.Variants)
            {
                zone.VariantIndex[variant.VariantId] = variant;

                foreach (var allocation in variant.Allocations)
                {
                    zone.AllocationIndex[allocation.Id] = allocation;
                }
            }
        }
    }


    private void UpdateCache(EditAllocationCallback callback)
    {

    }

}