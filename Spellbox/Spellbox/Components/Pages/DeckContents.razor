@page "/decks/{DeckId:guid}"

@if (_deck is null)
{
    <PageTitle>Spellbox</PageTitle>

    <MudProgressCircular Color="Color.Default" Indeterminate="true"/>
}
else
{

    <PageTitle>@_deck.Name</PageTitle>

    <CollectionDeckCard Deck="_deck"
                        OnEdit="OpenEditDeckDialog" />

    <MudPaper Class="px-4 pt-2 my-2"
              Outlined="true">

        <MudStack Row="true"
                  Spacing="0"
                  Justify="Justify.SpaceBetween"
                  Style="width: 100%">

            <MudContainer Gutters="false"
                          Class="mb-2">
                <MudText Typo="Typo.h6">
                    Commander(s)
                </MudText>

                <CardGridView Groups="_zones[DeckZoneType.Commanders].Groups"
                              VariantIndex="_zones[DeckZoneType.Commanders].VariantIndex"
                              AllocationIndex="_zones[DeckZoneType.Commanders].AllocationIndex"
                              OnEditSuccess="UpdateCacheOnEdit"
                              OnMoveSuccess="UpdateCacheOnMove"
                              ExpandVariants="_expandVariants"
                              @bind-SelectedAllocations="_selectedAllocations" />
            </MudContainer>

            @if (_zones[DeckZoneType.Companions].Groups.Count > 0)
            {
                <MudContainer Gutters="false"
                              Class="mb-1">
                    <MudText Typo="Typo.h6">
                        Companion(s)
                    </MudText>

                    <CardGridView Groups="_zones[DeckZoneType.Companions].Groups"
                                  VariantIndex="_zones[DeckZoneType.Companions].VariantIndex"
                                  AllocationIndex="_zones[DeckZoneType.Companions].AllocationIndex"
                                  OnEditSuccess="UpdateCacheOnEdit"
                                  OnMoveSuccess="UpdateCacheOnMove"
                                  ExpandVariants="_expandVariants" />
                </MudContainer>
            }

        </MudStack>

    </MudPaper>

    <MudPaper Class="pa-4 my-2"
              Outlined="true">
              
        <MudPaper Elevation="0"
                Class="mud-transparent">

            <MudStack Row="true" 
                    Spacing="0" 
                    Justify="Justify.SpaceEvenly"
                    AlignItems="AlignItems.End"
                    StretchItems="StretchItems.None">

                <MudContainer Style="width: 40%" 
                            Class="ma-0 pa-0">
                    <MudToggleGroup T="CardDisplayMode"
                                    @bind-Value="_displayMode"
                                    Size="Size.Small">
                        <MudToggleItem Value="CardDisplayMode.Grid">
                            <MudIcon Icon="@Icons.Material.Filled.GridView" />
                                Grid
                        </MudToggleItem>
                        <MudToggleItem Value="CardDisplayMode.Table">
                            <MudIcon Icon="@Icons.Material.Filled.TableRows" />
                                Table
                        </MudToggleItem>
                    </MudToggleGroup>
                </MudContainer>

                <MudContainer Style="width: 40%"
                            Class="ma-0 pa-0">
                    <MudToggleGroup T="bool"
                                    @bind-Value="_expandVariants"
                                    Size="Size.Small">
                        <MudToggleItem Value="false">
                            <MudIcon Icon="@Icons.Material.Filled.Filter1" />
                                Oracles
                        </MudToggleItem>
                        <MudToggleItem Value="true">
                            <MudIcon Icon="@Icons.Material.Filled.ViewModule" />
                                Variants
                        </MudToggleItem>
                    </MudToggleGroup>
                </MudContainer>

            </MudStack>

        </MudPaper>

        <MudPaper Elevation="0"
                Class="mud-transparent mt-0">

            <MudStack Row="true" 
                    Spacing="0" 
                    Justify="Justify.SpaceEvenly"
                    AlignItems="AlignItems.End"
                    StretchItems="StretchItems.None">

                <MudContainer Style="width: 40%"
                            Class="ma-0 pa-0">
                    <MudStack Row="true"
                            Justify="Justify.Center"
                            AlignItems="AlignItems.End"
                            Spacing="2">

                        <MudContainer Class="pa-0">
                            <MudSelect T="ColorIdentityFilterMode"
                                    Dense="true"
                                    @bind-Value="_CIFMode"
                                    @bind-Value:after="ApplyFilter">
                                @foreach (var mode in Enum.GetValues<ColorIdentityFilterMode>())
                                {
                                    <MudSelectItem Value="mode">
                                        @mode
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudContainer>

                        <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{C}")"
                                Size="Size.Large" 
                                Style=@(_CIF.C ? "" : "opacity: 0.3")
                                @onclick="@(() => {_CIF.C = !_CIF.C; ApplyFilter();})" />

                        <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{W}")"
                                Size="Size.Large"
                                Style=@(_CIF.W ? "" : "opacity: 0.3")
                                @onclick="@(() => {_CIF.W = !_CIF.W; ApplyFilter();})" />

                        <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{U}")"
                                Size="Size.Large" 
                                Style=@(_CIF.U ? "" : "opacity: 0.3")
                                @onclick="@(() => {_CIF.U = !_CIF.U; ApplyFilter();})" />

                        <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{B}")"
                                Size="Size.Large" 
                                Style=@(_CIF.B ? "" : "opacity: 0.3")
                                @onclick="@(() => {_CIF.B = !_CIF.B; ApplyFilter();})" />

                        <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{R}")"
                                Size="Size.Large" 
                                Style=@(_CIF.R ? "" : "opacity: 0.3")
                                @onclick="@(() => {_CIF.R = !_CIF.R; ApplyFilter();})" />

                        <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{G}")"
                                Size="Size.Large"
                                Style=@(_CIF.G ? "" : "opacity: 0.3")
                                @onclick="@(() => {_CIF.G = !_CIF.G; ApplyFilter();})" />

                    </MudStack>
                </MudContainer>

                <MudContainer Style="width: 40%"
                            Class="ma-0 pa-0">
                    <MudTextField Label="Search" 
                                T="string"
                                Variant="Variant.Text"
                                Clearable="true"
                                @bind-Value="_search"
                                @bind-Value:after="ApplyFilter"
                                Immediate="true"
                                DebounceInterval="0" />
                </MudContainer>

            </MudStack>

        </MudPaper>

    </MudPaper>

    <MudTabs Outlined="false"
             Rounded="true"
             ApplyEffectsToContainer="false"
             Centered="true">

        <MudTabPanel Text="@($"Mainboard {_zones[DeckZoneType.Mainboard].Quantity}")">
            <MudPaper Class="pa-4 mt-n0"
                      Outlined="true">

                @{
                    _selectedZone = DeckZoneType.Mainboard;
                }

                @if (_displayMode == CardDisplayMode.Grid)
                {
                    <CardGridView Groups="_zones[DeckZoneType.Mainboard].FilteredGroups"
                                  VariantIndex="_zones[DeckZoneType.Mainboard].VariantIndex"
                                  AllocationIndex="_zones[DeckZoneType.Mainboard].AllocationIndex"
                                  OnEditSuccess="UpdateCacheOnEdit"
                                  OnMoveSuccess="UpdateCacheOnMove"
                                  ExpandVariants="_expandVariants"
                                  @bind-SelectedAllocations="_selectedAllocations" />
                }
                else
                {
                    <CardTableView Groups="_zones[DeckZoneType.Mainboard].FilteredGroups"
                                   VariantIndex="_zones[DeckZoneType.Mainboard].VariantIndex"
                                   AllocationIndex="_zones[DeckZoneType.Mainboard].AllocationIndex"
                                   OnEditSuccess="UpdateCacheOnEdit" />
                }
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="@($"Sideboard {_zones[DeckZoneType.Sideboard].Quantity}")">
            <MudPaper Class="pa-4 mt-n0"
                      Outlined="true">

                @{
                    _selectedZone = DeckZoneType.Sideboard;
                }

                @if (_displayMode == CardDisplayMode.Grid)
                {
                    <CardGridView Groups="_zones[DeckZoneType.Sideboard].FilteredGroups"
                                  VariantIndex="_zones[DeckZoneType.Sideboard].VariantIndex"
                                  AllocationIndex="_zones[DeckZoneType.Sideboard].AllocationIndex"
                                  OnEditSuccess="UpdateCacheOnEdit"
                                  OnMoveSuccess="UpdateCacheOnMove"
                                  ExpandVariants="_expandVariants"
                                  @bind-SelectedAllocations="_selectedAllocations" />
                }
                else
                {
                    <CardTableView Groups="_zones[DeckZoneType.Sideboard].FilteredGroups"
                                   VariantIndex="_zones[DeckZoneType.Sideboard].VariantIndex"
                                   AllocationIndex="_zones[DeckZoneType.Sideboard].AllocationIndex"
                                   OnEditSuccess="UpdateCacheOnEdit" />
                }
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="@($"Maybeboard {_zones[DeckZoneType.Maybeboard].Quantity}")">
            <MudPaper Class="pa-4 mt-n0"
                      Outlined="true">

                @{
                    _selectedZone = DeckZoneType.Maybeboard;
                }

                @if (_displayMode == CardDisplayMode.Grid)
                {
                    <CardGridView Groups="_zones[DeckZoneType.Maybeboard].FilteredGroups"
                                  VariantIndex="_zones[DeckZoneType.Maybeboard].VariantIndex"
                                  AllocationIndex="_zones[DeckZoneType.Maybeboard].AllocationIndex"
                                  OnEditSuccess="UpdateCacheOnEdit"
                                  OnMoveSuccess="UpdateCacheOnMove"
                                  ExpandVariants="_expandVariants"
                                  @bind-SelectedAllocations="_selectedAllocations" />
                }
                else
                {
                    <CardTableView Groups="_zones[DeckZoneType.Maybeboard].FilteredGroups"
                                   VariantIndex="_zones[DeckZoneType.Maybeboard].VariantIndex"
                                   AllocationIndex="_zones[DeckZoneType.Maybeboard].AllocationIndex"
                                   OnEditSuccess="UpdateCacheOnEdit" />
                }
            </MudPaper>
        </MudTabPanel>
        
    </MudTabs>

    <CardSelectionComponent @bind-SelectedAllocations="_selectedAllocations"
                            OnMoveSuccess="UpdateCacheOnMove"
                            OnSelectAll="SelectAll" />

}


@inject CrossService CrossService
@inject CollectionService CollectionService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IPricingRouter PricingRouter
@inject SymbologyService SymbologyService
@code {

    [Parameter]
    public Guid DeckId { get; set; }

    private DeckDto? _deck;
    private Dictionary<DeckZoneType, ZoneDto> _zones = new ();

    public enum CardDisplayMode
    {
        Grid,
        Table
    }

    private CardDisplayMode _displayMode = CardDisplayMode.Grid;
    private bool _expandVariants = false;
    private HashSet<Guid> _selectedAllocations = new();
    private DeckZoneType _selectedZone = DeckZoneType.Mainboard;

    private CardColours _CIF = new CardColours();
    private ColorIdentityFilterMode _CIFMode = ColorIdentityFilterMode.AtMost;
    private string _search = "";

    private sealed class ZoneDto
    {
        public DeckZoneType ZoneType { get; init; }
        public List<CollectionGroupedOracleDto> Groups { get; init; } = [];
        public List<CollectionGroupedOracleDto> FilteredGroups { get; set; } = [];

        public int Quantity => FilteredGroups.Sum(g => g.Quantity);
        public decimal Price => FilteredGroups.Sum(g => g.Price);


        public Dictionary<Guid, CollectionGroupedVariantDto> VariantIndex { get; set; } = new();
        public Dictionary<Guid, CollectionAllocationDto> AllocationIndex { get; set; } = new();
    }


    protected override async Task OnParametersSetAsync()
    {
        _deck = await CollectionService.GetDeckDetails(DeckId);

        (_deck.PriceValue, _deck.PriceMissing) = await PricingRouter.GetDeckValueAsync(_deck.Id);

        var _zoneGroups = await CrossService.GetSnapshotZoneGroupsAsync(_deck.ActiveSnapshotId);
        _zones = _zoneGroups.Select(kvp =>
        {
            var zoneDto = new ZoneDto
            {
                ZoneType = kvp.Key,
                Groups = kvp.Value
            };

            BuildIndexes(zoneDto);

            return new KeyValuePair<DeckZoneType,ZoneDto>(kvp.Key, zoneDto);
        }).ToDictionary();

        ApplyFilter();
        StateHasChanged();
    }

    private void BuildIndexes(ZoneDto zone)
    {
        var groups = zone.Groups;
        zone.VariantIndex.Clear();
        zone.AllocationIndex.Clear();

        foreach (var oracle in groups)
        {
            foreach (var variant in oracle.Variants)
            {
                zone.VariantIndex[variant.VariantId] = variant;

                foreach (var allocation in variant.Allocations)
                {
                    zone.AllocationIndex[allocation.Id] = allocation;
                }
            }
        }
    }


    private void UpdateCacheOnMove(MoveAllocationsCallback callback)
    {

    }

    private void UpdateCacheOnEdit(EditAllocationCallback callback)
    {

    }


    private async Task OpenEditDeckDialog()
    {
        var parameters = new DialogParameters
        {
            ["DeckId"] = DeckId
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<EditDeckDialog>("Edit Deck", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is EditDeckCallback callback)
        {
            if (callback.IsUpdated)
            {
                _deck = callback.Deck;

                (_deck.PriceValue, _deck.PriceMissing) = await PricingRouter.GetDeckValueAsync(_deck.Id);
            }

            if (callback.IsDeleted)
            {
                if (callback.Transformed is null)
                {
                    NavigationManager.NavigateTo("/");
                    return;
                }
                else
                {
                    NavigationManager.NavigateTo($"/binders/{callback.Transformed.Id}");
                    return;
                }
            }

            StateHasChanged();
        }
    }


    private enum ColorIdentityFilterMode
    {
        AtMost,
        Equals,
        Contain
    }

    private void ApplyFilter()
    {
        var _cif = _CIF.ToInt();

        foreach (var kvp in _zones)
        {
            kvp.Value.FilteredGroups = kvp.Value.Groups;

            if (kvp.Key == DeckZoneType.Commanders || kvp.Key == DeckZoneType.Companions)
                continue;

            if (_cif != 0)
            {
                if (_CIFMode == ColorIdentityFilterMode.AtMost)
                {
                    kvp.Value.FilteredGroups = kvp.Value.FilteredGroups
                        .Where(oracle => ((oracle.ColorIdentity | _cif) ^ _cif) == 0 )
                        .ToList();

                    if (!_CIF.C)
                        kvp.Value.FilteredGroups = kvp.Value.FilteredGroups
                            .Where(oracle => oracle.ColorIdentity > 0)
                            .ToList();
                }

                if (_CIFMode == ColorIdentityFilterMode.Equals)
                {
                    if (_cif == 16)
                        kvp.Value.FilteredGroups = kvp.Value.FilteredGroups
                            .Where(oracle => oracle.ColorIdentity == 0)
                            .ToList();
                    else
                        kvp.Value.FilteredGroups = kvp.Value.FilteredGroups
                            .Where(oracle => oracle.ColorIdentity == _cif)
                            .ToList();
                }

                if (_CIFMode == ColorIdentityFilterMode.Contain)
                {
                    kvp.Value.FilteredGroups = kvp.Value.FilteredGroups
                        .Where(oracle => 
                            (oracle.ColorIdentity & _cif) == (_cif & 47) ||
                            _CIF.C ? oracle.ColorIdentity == 0 : false
                        )
                        .ToList();
                }
            }

            if (!String.IsNullOrWhiteSpace(_search))
            {
                kvp.Value.FilteredGroups = kvp.Value.FilteredGroups
                    .Where(oracle => oracle.Name.ToLowerInvariant().Contains(_search.ToLowerInvariant()))
                    .ToList();
            }
        }
    }

    private void SelectAll()
    {
        _selectedAllocations
            .UnionWith(_zones[_selectedZone].FilteredGroups
                .SelectMany(og => og.Variants
                    .SelectMany(vg => vg.Allocations
                        .Select(a => a.Id))));
    }

}