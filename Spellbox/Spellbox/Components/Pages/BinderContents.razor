@page "/binders/{BinderId:guid}"

@if (_binder == null)
{
    <PageTitle>Spellbox</PageTitle>

    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else
{

    <PageTitle>@_binder.Name</PageTitle>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h4">
            @_binder.Name
        </MudText>

        <MudText Typo="Typo.h6">
            @_binder.Description
        </MudText>
    </MudPaper>

    <MudToggleGroup T="CardDisplayMode"
                    @bind-Value="_displayMode">
        <MudToggleItem Value="CardDisplayMode.Grid">
            <MudIcon Icon="@Icons.Material.Filled.GridView" />
                Grid
        </MudToggleItem>
        <MudToggleItem Value="CardDisplayMode.Table">
            <MudIcon Icon="@Icons.Material.Filled.TableRows" />
                Table
        </MudToggleItem>
    </MudToggleGroup>

    <MudPaper Class="pa-4">

        @if (_displayMode == CardDisplayMode.Grid)
        {
            <CardGridView Groups="_groups" 
                          SubcollectionName="@_binder.Name"
                          OnEditSuccess="ReloadAsync" />
        }
        else
        {
            @* <CardTableView Groups="_groups" SubcollectionName="@_binder.Name" /> *@
        }

    </MudPaper>

}


@inject CrossService CrossService
@inject CollectionService CollectionService
@code {

    [Parameter]
    public Guid BinderId { get; set; }

    // UI Caches
    private CollectionBinderDto? _binder;
    private List<CollectionGroupedOracleDto> _groups = new List<CollectionGroupedOracleDto>();

    // UI States
    private CardDisplayMode _displayMode = CardDisplayMode.Grid;

    public enum CardDisplayMode
    {
        Grid,
        Table
    }
    
    protected override async Task OnParametersSetAsync()
    {
        _binder = await CollectionService.GetBinderDetails(BinderId);
        _groups = await CrossService.GetBinderGroupsAsync(BinderId);
        StateHasChanged();
    }


    private async Task ReloadAsync(EditCallback callback)
    {
        if (callback.IsDeleted)
        {
            @* _groups.RemoveAll(g => g.VariantId == callback.VariantId); *@
        }
        else
        {
            @* var group = _groups.Single(g => g.VariantId == callback.VariantId); *@
            @* await CollectionService.UpdateVariantGroupAsync(group); *@
        }

        StateHasChanged();
    }

}