@page "/search"


<PageTitle>Card Search</PageTitle>


<MudContainer Style="max-width: 1280px">

    <MudStack Spacing="2">

        <MudPaper Outlined="true"
                  Class="px-4 pb-4 pt-2">

            <CardSearchComponent OnSelectFunc="OnVariantSelect" />

        </MudPaper>

        @if (_viewer is null)
        {
            <MudPaper Outlined="true"
                      Class="pa-4">

                <MudText>No card selected...</MudText>

            </MudPaper>
        }
        else
        {
            <MudPaper Outlined="true"
                      Class="py-0 px-4">

                <CardViewerComponent Viewer="_viewer" />

            </MudPaper>

            <MudPaper Outlined="true"
                      Class="pa-4">

                <CardViewerTable Viewer="_viewer" />

            </MudPaper>
        }

    </MudStack>

</MudContainer>


@code {

    private CardDetailsViewerDto? _viewer;


    private void OnVariantSelect(CardDetailsViewerDto viewer)
    {
        if (viewer is null)
            return;

        _viewer = viewer;

        StateHasChanged();
    }

}