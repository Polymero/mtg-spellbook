@page "/unassigned"


<PageTitle>Unassigned</PageTitle>

@if (_groups.Count == 0)
{
    <MudText>
        What are you doing here? You have no unassigned cards. Shoo ~ !
    </MudText>
}
else
{
    <MudPaper Elevation="1"
              Class="pa-4"
              Outlined="true">
        <MudText Typo="Typo.h4"
                 Align="Align.Center"
                 Class="pb-2">
            Unassigned Cards
        </MudText>

        <MudText Align="Align.Center">
            These cards have not been assigned to any binder or deck. Why not give them a home?
        </MudText>
    </MudPaper>

    <MudPaper Elevation="0"
              Class="pa-4 mud-transparent">
        <MudStack Row="true" 
                  Spacing="0" 
                  Justify="Justify.SpaceEvenly"
                  AlignItems="AlignItems.End"
                  StretchItems="StretchItems.None">

            <MudContainer Style="width: 40%" 
                          Class="ma-0 pa-0">
                <MudToggleGroup T="CardDisplayMode"
                                @bind-Value="_displayMode"
                                Size="Size.Small">
                    <MudToggleItem Value="CardDisplayMode.Grid">
                        <MudIcon Icon="@Icons.Material.Filled.GridView" />
                            Grid
                    </MudToggleItem>
                    <MudToggleItem Value="CardDisplayMode.Table">
                        <MudIcon Icon="@Icons.Material.Filled.TableRows" />
                            Table
                    </MudToggleItem>
                </MudToggleGroup>
            </MudContainer>

            <MudContainer Style="width: 40%"
                          Class="ma-0 pa-0">
                <MudToggleGroup T="bool"
                                @bind-Value="_expandVariants"
                                Size="Size.Small">
                    <MudToggleItem Value="false">
                        <MudIcon Icon="@Icons.Material.Filled.Filter1" />
                            Oracles
                    </MudToggleItem>
                    <MudToggleItem Value="true">
                        <MudIcon Icon="@Icons.Material.Filled.ViewModule" />
                            Variants
                    </MudToggleItem>
                </MudToggleGroup>
            </MudContainer>

        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0"
              Class="pa-4 mud-transparent mt-n8">
        <MudStack Row="true" 
                  Spacing="0" 
                  Justify="Justify.SpaceEvenly"
                  AlignItems="AlignItems.End"
                  StretchItems="StretchItems.None">

            <MudContainer Style="width: 40%"
                          Class="ma-0 pa-0">
                <MudStack Row="true"
                          Justify="Justify.Center"
                          AlignItems="AlignItems.End"
                          Spacing="2">

                    <MudContainer Class="pa-0">
                        <MudSelect T="ColorIdentityFilterMode"
                                Dense="true"
                                @bind-Value="_CIFMode"
                                @bind-Value:after="ApplyFilter">
                            @foreach (var mode in Enum.GetValues<ColorIdentityFilterMode>())
                            {
                                <MudSelectItem Value="mode">
                                    @mode
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudContainer>

                    <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{C}")"
                             Size="Size.Large" 
                             Style=@(_CIF.C ? "" : "opacity: 0.3")
                             @onclick="@(() => {_CIF.C = !_CIF.C; ApplyFilter();})" />

                    <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{W}")"
                            Size="Size.Large"
                            Style=@(_CIF.W ? "" : "opacity: 0.3")
                            @onclick="@(() => {_CIF.W = !_CIF.W; ApplyFilter();})" />

                    <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{U}")"
                            Size="Size.Large" 
                            Style=@(_CIF.U ? "" : "opacity: 0.3")
                            @onclick="@(() => {_CIF.U = !_CIF.U; ApplyFilter();})" />

                    <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{B}")"
                            Size="Size.Large" 
                            Style=@(_CIF.B ? "" : "opacity: 0.3")
                            @onclick="@(() => {_CIF.B = !_CIF.B; ApplyFilter();})" />

                    <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{R}")"
                            Size="Size.Large" 
                            Style=@(_CIF.R ? "" : "opacity: 0.3")
                            @onclick="@(() => {_CIF.R = !_CIF.R; ApplyFilter();})" />

                    <MudIcon Icon="@SymbologyService.RenderSymbolIcon("{G}")"
                            Size="Size.Large"
                            Style=@(_CIF.G ? "" : "opacity: 0.3")
                            @onclick="@(() => {_CIF.G = !_CIF.G; ApplyFilter();})" />

                </MudStack>
            </MudContainer>

            <MudContainer Style="width: 40%"
                          Class="ma-0 pa-0">
                <MudTextField Label="Search" 
                              T="string"
                              Variant="Variant.Text"
                              Clearable="true"
                              @bind-Value="_search"
                              @bind-Value:after="ApplyFilter"
                              Immediate="true"
                              DebounceInterval="0" />
            </MudContainer>

        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4"
              Outlined="true">

        <MudText Typo="Typo.h6" 
                 Align="Align.Center"
                 Class="mt-n2">
            <span style="font-size: 0.75em"><i>
                @_filteredGroups.Sum(g => g.Quantity) cards
                &nbsp; (€@_filteredGroups.Sum(g => g.Price).ToString("0.00"))
            </i></span>
        </MudText>

        @if (_displayMode == CardDisplayMode.Grid)
        {
            <CardGridView Groups="_filteredGroups"
                          VariantIndex="_variantIndex"
                          AllocationIndex="_allocationIndex"
                          OnEditSuccess="UpdateCacheOnEdit"
                          OnMoveSuccess="UpdateCacheOnMove"
                          ExpandVariants="_expandVariants"
                          @bind-SelectedAllocations="_selectedAllocations" />
        }
        else
        {
            <CardTableView Groups="_filteredGroups"
                           VariantIndex="_variantIndex"
                           AllocationIndex="_allocationIndex"
                           OnEditSuccess="UpdateCacheOnEdit" />
        }

    </MudPaper>

    <CardSelectionComponent @bind-SelectedAllocations="_selectedAllocations"
                            OnMoveSuccess="UpdateCacheOnMove"
                            OnSelectAll="SelectAll" />

}


@inject CrossService CrossService
@inject CollectionService CollectionService
@inject SymbologyService SymbologyService
@code {

    // UI Cache
    private List<CollectionGroupedOracleDto> _groups =[];
    private List<CollectionGroupedOracleDto> _filteredGroups = [];
    private Dictionary<Guid, CollectionGroupedVariantDto> _variantIndex = new();
    private Dictionary<Guid, CollectionAllocationDto> _allocationIndex = new();
    private HashSet<Guid> _selectedAllocations = new();

    // UI States
    private CardDisplayMode _displayMode = CardDisplayMode.Grid;
    private bool _expandVariants = false;
    private CardColours _CIF = new CardColours();
    private ColorIdentityFilterMode _CIFMode = ColorIdentityFilterMode.AtMost;
    private string _search = "";

    public enum CardDisplayMode
    {
        Grid,
        Table
    }
    
    protected override async Task OnParametersSetAsync()
    {
        _groups = await CrossService.GetUnassignedGroupsAsync();

        BuildIndexes(_groups);
        ApplyFilter();
        StateHasChanged();
    }

    private void BuildIndexes(IEnumerable<CollectionGroupedOracleDto> groups)
    {
        _variantIndex.Clear();
        _allocationIndex.Clear();

        foreach (var oracle in groups)
        {
            foreach (var variant in oracle.Variants)
            {
                _variantIndex[variant.VariantId] = variant;

                foreach (var allocation in variant.Allocations)
                {
                    _allocationIndex[allocation.Id] = allocation;
                }
            }
        }
    }


    private void UpdateCacheOnMove(MoveAllocationsCallback callback)
    {
        foreach (var allocId in callback.AllocationIds)
        {
            if (!_allocationIndex.TryGetValue(allocId, out var alloc))
                continue;

            var variant = _variantIndex[alloc.VariantId];

            variant.Allocations.Remove(alloc);

            _allocationIndex.Remove(alloc.Id);

            if (variant.Allocations.Count == 0)
                RemoveVariant(variant);
        }
        
        StateHasChanged();
        ApplyFilter();
    }

    private void UpdateCacheOnEdit(EditAllocationCallback callback)
    {
        if (callback.IsDeleted)
            RemoveAllocation(callback.Allocation);

        else if (callback.IsUpdated)
            UpdateAllocation(callback.Allocation, removeIfMoved: true);

        StateHasChanged();
        ApplyFilter();
    }

    private void RemoveAllocation(CollectionAllocationDto deletedAllocation)
    {
        if (!_allocationIndex.TryGetValue(deletedAllocation.Id, out var allocation))
            return;

        var variant = _variantIndex[allocation.VariantId];

        variant.Allocations.Remove(allocation);

        _allocationIndex.Remove(allocation.Id);

        if (variant.Allocations.Count == 0)
            RemoveVariant(variant);
    }

    private void RemoveVariant(CollectionGroupedVariantDto variant)
    {
        var oracle = _groups
        .Where(g => g.Variants.Contains(variant))
        .Single();

        oracle.Variants.Remove(variant);

        _variantIndex.Remove(variant.VariantId);

        if (oracle.Variants.Count == 0)
            RemoveOracle(oracle);
    }

    private void RemoveOracle(CollectionGroupedOracleDto oracle)
    {
        _groups.Remove(oracle);
    }

    private void UpdateAllocation(CollectionAllocationDto updatedAllocation, bool removeIfMoved = false)
    {
        if (!_allocationIndex.TryGetValue(updatedAllocation.Id, out var allocation))
            return;

        if (removeIfMoved && (allocation.BinderId != updatedAllocation.BinderId || allocation.ZoneId != updatedAllocation.ZoneId))
            {
                RemoveAllocation(updatedAllocation);
                return;
            }

        var variant = _variantIndex[updatedAllocation.VariantId];

        var index = variant.Allocations
            .FindIndex(a => a.Id == updatedAllocation.Id);

        if (index >= 0)
        {
            variant.Allocations[index] = updatedAllocation;

            _allocationIndex[updatedAllocation.Id] = updatedAllocation;
        }
    }



    private enum ColorIdentityFilterMode
    {
        AtMost,
        Equals,
        Contain
    }

    private void ApplyFilter()
    {
        _filteredGroups = _groups;
        var _cif = _CIF.ToInt();

        if (_cif != 0)
        {
            if (_CIFMode == ColorIdentityFilterMode.AtMost)
            {
                _filteredGroups = _filteredGroups
                    .Where(oracle => ((oracle.ColorIdentity | _cif) ^ _cif) == 0 )
                    .ToList();

                if (!_CIF.C)
                    _filteredGroups = _filteredGroups
                        .Where(oracle => oracle.ColorIdentity > 0)
                        .ToList();
            }

            if (_CIFMode == ColorIdentityFilterMode.Equals)
            {
                if (_cif == 16)
                    _filteredGroups = _filteredGroups
                        .Where(oracle => oracle.ColorIdentity == 0)
                        .ToList();
                else
                    _filteredGroups = _filteredGroups
                        .Where(oracle => oracle.ColorIdentity == _cif)
                        .ToList();
            }

            if (_CIFMode == ColorIdentityFilterMode.Contain)
            {
                _filteredGroups = _filteredGroups
                    .Where(oracle => 
                        (oracle.ColorIdentity & _cif) == (_cif & 47) ||
                        _CIF.C ? oracle.ColorIdentity == 0 : false
                    )
                    .ToList();
            }
        }

        if (!String.IsNullOrWhiteSpace(_search))
        {
            _filteredGroups = _filteredGroups
                .Where(oracle => oracle.Name.ToLowerInvariant().Contains(_search.ToLowerInvariant()))
                .ToList();
        }
    }

    private void SelectAll()
    {
        _selectedAllocations
            .UnionWith(_filteredGroups
                .SelectMany(og => og.Variants
                    .SelectMany(vg => vg.Allocations
                        .Select(a => a.Id))));
    }

}
