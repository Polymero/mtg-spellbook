@page "/unassigned"


<PageTitle>Unassigned</PageTitle>

@if (_groups.Count == 0)
{
    <MudText>
        What are you doing here? You have no unassigned cards. Shoo ~ !
    </MudText>
}
else
{
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h4">
            Unassigned Cards
        </MudText>

        <MudText Typo="Typo.h6">
            These cards have not been assigned to any binder or deck. Why not give them a home?
        </MudText>
    </MudPaper>

    <MudToggleGroup T="CardDisplayMode"
                    @bind-Value="_displayMode">
        <MudToggleItem Value="CardDisplayMode.Grid">
            <MudIcon Icon="@Icons.Material.Filled.GridView" />
                Grid
        </MudToggleItem>
        <MudToggleItem Value="CardDisplayMode.Table">
            <MudIcon Icon="@Icons.Material.Filled.TableRows" />
                Table
        </MudToggleItem>
    </MudToggleGroup>

    <MudPaper Class="pa-4">

        @if (_displayMode == CardDisplayMode.Grid)
        {
            <CardGridView Groups="_groups"
                          VariantIndex="_variantIndex"
                          AllocationIndex="_allocationIndex"
                          OnEditSuccess="UpdateCache" />
        }
        else
        {
            <CardTableView Groups="_groups"
                           VariantIndex="_variantIndex"
                           AllocationIndex="_allocationIndex"
                           OnEditSuccess="UpdateCache" />
        }

    </MudPaper>

}


@inject CrossService CrossService
@inject CollectionService CollectionService
@code {

    // UI Cache
    private List<CollectionGroupedOracleDto> _groups =[];
    private Dictionary<Guid, CollectionGroupedVariantDto> _variantIndex = new();
    private Dictionary<Guid, CollectionAllocationDto> _allocationIndex = new();

    // UI States
    private CardDisplayMode _displayMode = CardDisplayMode.Grid;

    public enum CardDisplayMode
    {
        Grid,
        Table
    }
    
    protected override async Task OnParametersSetAsync()
    {
        _groups = await CrossService.GetUnassignedGroupsAsync();

        BuildIndexes(_groups);
        StateHasChanged();
    }

    private void BuildIndexes(IEnumerable<CollectionGroupedOracleDto> groups)
    {
        _variantIndex.Clear();
        _allocationIndex.Clear();

        foreach (var oracle in groups)
        {
            foreach (var variant in oracle.Variants)
            {
                _variantIndex[variant.VariantId] = variant;

                foreach (var allocation in variant.Allocations)
                {
                    _allocationIndex[allocation.Id] = allocation;
                }
            }
        }
    }


    private void UpdateCache(EditAllocationCallback callback)
    {
        if (callback.IsDeleted)
            RemoveAllocation(callback.Allocation);

        else if (callback.IsUpdated)
            UpdateAllocation(callback.Allocation, removeIfMoved: true);

        StateHasChanged();
    }

    private void RemoveAllocation(CollectionAllocationDto deletedAllocation)
    {
        if (!_allocationIndex.TryGetValue(deletedAllocation.Id, out var allocation))
            return;

        var variant = _variantIndex[allocation.VariantId];

        variant.Allocations.Remove(allocation);

        _allocationIndex.Remove(allocation.Id);

        if (variant.Allocations.Count == 0)
            RemoveVariant(variant);
    }

    private void RemoveVariant(CollectionGroupedVariantDto variant)
    {
        var oracle = _groups
        .Where(g => g.Variants.Contains(variant))
        .Single();

        oracle.Variants.Remove(variant);

        _variantIndex.Remove(variant.VariantId);

        if (oracle.Variants.Count == 0)
            RemoveOracle(oracle);
    }

    private void RemoveOracle(CollectionGroupedOracleDto oracle)
    {
        _groups.Remove(oracle);
    }

    private void UpdateAllocation(CollectionAllocationDto updatedAllocation, bool removeIfMoved = false)
    {
        if (!_allocationIndex.TryGetValue(updatedAllocation.Id, out var allocation))
            return;

        if (removeIfMoved && (allocation.BinderId != updatedAllocation.BinderId || allocation.ZoneId != updatedAllocation.ZoneId))
            {
                RemoveAllocation(updatedAllocation);
                return;
            }

        var variant = _variantIndex[updatedAllocation.VariantId];

        var index = variant.Allocations
            .FindIndex(a => a.Id == updatedAllocation.Id);

        if (index >= 0)
        {
            variant.Allocations[index] = updatedAllocation;

            _allocationIndex[updatedAllocation.Id] = updatedAllocation;
        }
    }

}
