@page "/"
@using MudBlazor

<PageTitle>
    Spellbox
</PageTitle>


<MudPaper Elevation="0"
          Class="my-12 mud-transparent">
    <MudText Typo="Typo.h2"
             Align="Align.Center">
        Welcome back <b>@_displayName</b> ~ !
    </MudText>
</MudPaper>

<MudPaper Elevation="0"
          Class="my-12 mud-transparent">
    <MudText Typo="Typo.h5"
             Align="Align.Center">
        @if (_collectionPriceMissing > 0)
        {
            <span>Your collection: @_collectionQuantity cards (€@_collectionPriceValue.ToString("0.00") + @_collectionPriceMissing?)</span>
        }
        else
        {
            <span>Your collection: @_collectionQuantity cards (€@_collectionPriceValue.ToString("0.00"))</span>
        }
    </MudText>
</MudPaper>

<MudPaper Elevation="0"
          Class="my-8 d-flex justify-center mud-transparent">
    <MudButton Variant="Variant.Filled"
               Color="Color.Info"
               @onclick="OpenAddCollectionCardDialog">
        Add Card(s) to Collection
    </MudButton>
</MudPaper>


<MudStack Class="my-8">

    @if (Unassigned is not null && Unassigned.Quantity > 0)
    {
        <MudText Align="Align.Center">
            You have @Unassigned.Quantity <MudLink Href="/unassigned">unassigned</MudLink> card(s) just hanging around. Give them a home!
        </MudText>
    }

    <!-- Binders -->
    <MudGrid Spacing="2">

        <MudItem xs="12">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">
                        Your Binders:
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton @onclick="OpenAddBinderDialog" 
                                   Icon="@Icons.Material.Filled.Add"
                                   Variant="Variant.Outlined" 
                                   Color="Color.Success"
                                   Class="align-end" />
                </CardHeaderActions>
            </MudCardHeader>
        </MudItem>

        @if (BinderCache == null)
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        }
        else if (BinderCache.Count == 0)
        {
            <MudText>
                You have no binders. What have you done?
            </MudText>
        }
        else
        {    
            @foreach (var binder in BinderCache)
            {
                <MudItem xs="12">
                    <CollectionBinderCard Binder="binder"
                                           OnEdit="OpenEditBinderDialog" />
                </MudItem>
            }   
        }

    </MudGrid>


    @* <MudDivider /> *@


    <!-- Decks -->
    <MudGrid Spacing="2">

        <MudItem xs="12">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">
                        Your Decks:
                    </MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton @onclick="OpenAddDeckDialog" 
                                   Icon="@Icons.Material.Filled.Add"
                                   Variant="Variant.Outlined" 
                                   Color="Color.Success"
                                   Class="align-end" />
                </CardHeaderActions>
            </MudCardHeader>
        </MudItem>

        @if (DeckCache == null)
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        }
        else if (DeckCache.Count == 0)
        {
            <MudText>
                You have no decks yet. Why not build one?
            </MudText>
        }
        else
        {    
            @foreach (var deck in DeckCache)
            {
                <MudItem xs="12">
                    <CollectionDeckCard Deck="deck"
                                        OnEdit="OpenEditDeckDialog" />
                </MudItem>
            }   
        }

    </MudGrid>
</MudStack>

@inject CollectionService CollectionService
@inject IDialogService DialogService
@inject IPricingRouter PricingRouter
@inject IUserSessionService UserSession
@code {

    // UI caches
    private List<CollectionBinderDto> BinderCache { get; set; } = new List<CollectionBinderDto>();
    private List<DeckDto> DeckCache { get; set; } = new List<DeckDto>();
    
    private sealed record UnassignedDto
    (
        int Quantity,
        decimal PriceValue,
        int PriceMissing
    );
    private UnassignedDto? Unassigned;

    private string _displayName = null!;
    private int _collectionQuantity;
    private decimal _collectionPriceValue;
    private int _collectionPriceMissing;

    protected override async Task OnInitializedAsync()
    {
        var session = await UserSession.GetAsync();
        _displayName = session.DisplayName;

        Unassigned = await LoadUnassigned();

        BinderCache = await CollectionService.GetAllBinders();
        foreach (var binder in BinderCache)
            (binder.PriceValue, binder.PriceMissing) = await PricingRouter.GetBinderValueAsync(binder.Id);

        DeckCache = await CollectionService.GetAllDecks();
        foreach (var deck in DeckCache)
            (deck.PriceValue, deck.PriceMissing) = await PricingRouter.GetDeckValueAsync(deck.Id);

        _collectionQuantity = Unassigned.Quantity +
            BinderCache.Sum(b => b.Quantity) +
            DeckCache.Sum(d => d.Quantity);
        _collectionPriceValue = Unassigned.PriceValue + 
            BinderCache.Sum(b => b.PriceValue) +
            DeckCache.Sum(d => d.PriceValue);
        _collectionPriceMissing = Unassigned.PriceMissing +
            BinderCache.Sum(b => b.PriceMissing) +
            DeckCache.Sum(d => d.PriceMissing);
    }

    private async Task<UnassignedDto> LoadUnassigned()
    {
        var quantity = await CollectionService.GetQuantityUnassigned();
        (var value, var missing) = await PricingRouter.GetUnassignedValueAsync();

        return new UnassignedDto(quantity, value, missing);
    }


    // Open dialog to add a binder to the collection database
    private async Task OpenAddBinderDialog()
    {
        var options = new DialogOptions 
        {
            CloseButton = true, 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddBinderDialog>("Add Binder", options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is CollectionBinderDto newBinder)
        {
            BinderCache.Add(newBinder);
            StateHasChanged();
        }
    }

    private async Task OpenEditBinderDialog(Guid binderId)
    {
        var parameters = new DialogParameters
        {
            ["BinderId"] = binderId
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<EditBinderDialog>("Edit Binder", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is EditBinderCallback callback)
        {
            if (callback.IsUpdated)
            {
                var index = BinderCache
                    .FindIndex(b => b.Id == callback.Binder.Id);

                (callback.Binder.PriceValue, callback.Binder.PriceMissing) = await PricingRouter.GetBinderValueAsync(callback.Binder.Id);

                if (index >= 0)
                    BinderCache[index] = callback.Binder;
            }

            if (callback.IsDeleted)
            {
                BinderCache.RemoveAll(b => b.Id == callback.Binder.Id);

                Unassigned = await LoadUnassigned();
            }

            StateHasChanged();
        }
    }


    // Open dialog to add a deck to the collection database
    private async Task OpenAddDeckDialog()
    {
        var options = new DialogOptions 
        {
            CloseButton = true, 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddDeckDialog>("Add Deck", options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is DeckDto newDeck)
        {
            DeckCache.Add(newDeck);
            StateHasChanged();
        }
    }

    private async Task OpenEditDeckDialog(Guid deckId)
    {
        var parameters = new DialogParameters
        {
            ["DeckId"] = deckId
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<EditDeckDialog>("Edit Deck", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is EditDeckCallback callback)
        {
            if (callback.IsUpdated)
            {
                var index = DeckCache
                    .FindIndex(b => b.Id == callback.Deck.Id);

                (callback.Deck.PriceValue, callback.Deck.PriceMissing) = await PricingRouter.GetDeckValueAsync(callback.Deck.Id);

                if (index >= 0)
                    DeckCache[index] = callback.Deck;
            }

            if (callback.IsDeleted)
            {
                DeckCache.RemoveAll(b => b.Id == callback.Deck.Id);

                Unassigned = await LoadUnassigned();
            }

            StateHasChanged();
        }
    }


    // Open dialog to add a physical copy of a card to the collection database
    private async Task OpenAddCollectionCardDialog()
    {
        var parameters = new DialogParameters
        {
            
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = false,
            BackdropClick = false,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddAllocationDialog>("Add Card", parameters, options);
        var result = await dialog.Result;
    }

}

