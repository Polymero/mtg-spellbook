@page "/import_collection"


<PageTitle>Import Collection</PageTitle>


<MudStack Spacing="2">

    <MudPaper Class="pa-4"
            Outlined="true">

        <MudStack AlignItems="AlignItems.Center"
                Spacing="3">

            <MudText>
                Step 1: Upload a list of cards as a <code>.csv</code> file.
            </MudText>

            <InputFile id="_inputFile" 
                    accept=".csv"
                    style="display:none"
                    OnChange="HandleFileSelected" />

            <label for="_inputFile">
                <MudButton Variant="Variant.Filled"
                        Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.FileUpload"
                        HtmlTag="_inputFile"
                        Disabled="_isLoading">
                    Upload
                </MudButton>
            </label>

            @if (_result is not null)
            {
                @if (_result.Errors.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning"
                            Dense="true">
                        <MudText>
                        
                        </MudText>
                        <MudList T="string"
                                Dense="true">
                            @foreach (var error in _result.Errors)
                            {
                                <MudListItem Text="@error"
                                            Icon="@Icons.Material.Filled.ErrorOutline" />
                            }
                        </MudList>
                    </MudAlert>
                }

                <MudAlert Severity="Severity.Success"
                        Dense="true">
                    <MudText>
                        @_result.Cards.Sum(c => c.Quantity) entries detected in <MudChip T="string" Color="Color.Info">@_fileName</MudChip> ~ !
                    </MudText>
                </MudAlert>
            }

        </MudStack>
    </MudPaper>


    @if (_isLoading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }


    @if (_result is not null)
    {
        <MudPaper Class="pa-4"
                Outlined="true">
            <MudStack AlignItems="AlignItems.Center"
                    Spacing="3">

                <MudText>
                    Step 2: Parse entries into Spellbox cards.
                </MudText>

                <MudCheckBox T="bool"
                             Label="Parse purchase prices"
                             @bind-Value="_isParsePurchasePrices" />

                <MudButton Variant="Variant.Filled"
                        Color="Color.Primary"
                        Disabled="@(!CanParse)"
                        OnClick="ParseAsync">
                    Parse
                </MudButton>

                @if (_parsed is not null)
                {
                    @if (_parsed.Errors.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning"
                                Dense="true">
                            <MudText>
                            
                            </MudText>
                            <MudList T="string"
                                    Dense="true">
                                @foreach (var error in _parsed.Errors)
                                {
                                    <MudListItem Text="@error"
                                                Icon="@Icons.Material.Filled.ErrorOutline" />
                                }
                            </MudList>
                        </MudAlert>
                    }

                    <MudAlert Severity="Severity.Success"
                            Dense="true">
                        <MudText>
                            @_parsed.Cards.Count of @_result.Cards.Sum(c => c.Quantity) card(s) parsed succesfully ~ !
                        </MudText>
                    </MudAlert>

                    <MudTable Items="_parsed.Cards"
                            T="NewAllocationDto"
                            Dense="true"
                            Hover="true"
                            Style="max-height: 720px; overflow-y: scroll; width: 80%">

                        <HeaderContent>
                            <MudTh>
                                <MudTableSortLabel SortBy="new Func<NewAllocationDto, object>(a => a.Name)">
                                    Name
                                </MudTableSortLabel>
                            </MudTh>
                            <MudTh>Code</MudTh>
                            <MudTh>Finish</MudTh>
                            <MudTh>Language</MudTh>
                            <MudTh>Condition</MudTh>
                            <MudTh>Flags</MudTh>
                            <MudTh>Bought</MudTh>
                        </HeaderContent>
                        
                        <RowTemplate Context="a">
                            <MudTd>@a.Name</MudTd>
                            <MudTd>@String.Format("{0} {1}", a.SetCode.ToUpper(), a.CollNum)</MudTd>
                            <MudTd>
                                @switch (a.Finish)
                                {
                                    case CardFinish.Unknown: <MudChip T="string" Label="true" Size="Size.Small"><b>—</b></MudChip> break;
                                    case CardFinish.NonFoil: <MudIcon Icon="@Icons.Material.Rounded.StarBorder" Title="NonFoil" /> break;
                                    case CardFinish.Foil: <MudIcon Icon="@Icons.Material.Rounded.Star" Title="Foil" /> break;
                                    default: @a.Finish.ToString() break;
                                }
                            </MudTd>
                            <MudTd>@a.Language</MudTd>
                            <MudTd>
                                @switch (a.Condition)
                                {
                                    case CardCondition.Mint: <MudChip T="string" Label="true" Size="Size.Small"><b>MT</b></MudChip> break;
                                    case CardCondition.NearMint: <MudChip T="string" Label="true" Size="Size.Small"><b>NM</b></MudChip> break;
                                    case CardCondition.Excellent: <MudChip T="string" Label="true" Size="Size.Small"><b>EX</b></MudChip> break;
                                    case CardCondition.Good: <MudChip T="string" Label="true" Size="Size.Small"><b>GD</b></MudChip> break;
                                    case CardCondition.LightPlayed: <MudChip T="string" Label="true" Size="Size.Small"><b>LP</b></MudChip> break;
                                    case CardCondition.Played: <MudChip T="string" Label="true" Size="Size.Small"><b>PL</b></MudChip> break;
                                    case CardCondition.Poor: <MudChip T="string" Label="true" Size="Size.Small"><b>PO</b></MudChip> break;
                                    default: <MudChip T="string" Label="true" Size="Size.Small"><b>—</b></MudChip> break;
                                }
                            </MudTd>
                            <MudTd>
                                @if (a.IsAltered) { <MudIcon Icon="@Icons.Material.Filled.Filter" Title="Altered" /> }
                                @if (a.IsSigned) { <MudIcon Icon="@Icons.Material.Filled.Draw" Title="Signed" /> }
                                @if (a.IsStamped) { <MudIcon Icon="@Icons.Material.Filled.Bookmark" Title="Stamped" /> }
                                @if (a.IsMisprint) { <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Title="Misprint" /> }
                            </MudTd>
                            <MudTd>
                                @if (a.BoughtFor.HasValue) { <span>€@a.BoughtFor?.ToString("0.00")</span> }
                                else { <span>—</span> }
                            </MudTd>
                        </RowTemplate>

                        <PagerContent>
                            <MudTablePager PageSizeOptions="new[] {50, 100, 250}" />
                        </PagerContent>

                    </MudTable>
                }

            </MudStack>
        </MudPaper>
    }


    @if (_parsed is not null)
    {
        <MudPaper Class="pa-4"
                Outlined="true">
            <MudStack AlignItems="AlignItems.Center"
                      Spacing="3">

                <MudText>
                    Step 3: Store cards in your collection database.
                </MudText>

                <MudStack Row="true"
                          AlignItems="AlignItems.End"
                          Justify="Justify.Center"
                          Spacing="4"
                          StretchItems="StretchItems.None"
                          Style="width: 80%"
                          Class="mt-n2 mb-2">

                    <MudText>Target:</MudText>

                    <MudContainer Gutters="false">
                        <MudSelect T="CollectionBinderDto"
                                Label="Binder"
                                Clearable="true"
                                Disabled="@(_selectedDeck is not null)"
                                @bind-Value="_selectedBinder">
                            @foreach (var b in BinderCache)
                            {
                                <MudSelectItem Value="b">
                                    @b.Name
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudContainer>

                    <MudIconButton @onclick="OpenAddBinderDialog" 
                                   Icon="@Icons.Material.Filled.Add"
                                   Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Class="ml-n4" />

                    <MudText>or</MudText>

                    <MudContainer Gutters="false">
                        <MudSelect T="DeckDto"
                                Label="Deck"
                                Clearable="true"
                                Disabled="@(_selectedBinder is not null)"
                                @bind-Value="_selectedDeck">
                            @foreach (var d in DeckCache)
                            {
                                <MudSelectItem Value="d">
                                    @d.Name
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudContainer>

                    <MudIconButton @onclick="OpenAddDeckDialog" 
                                   Icon="@Icons.Material.Filled.Add"
                                   Variant="Variant.Outlined" 
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Class="ml-n4" />

                </MudStack>

                <MudButton Variant="Variant.Filled"
                        Color="Color.Primary"
                        Disabled="@(!CanSubmit)"
                        OnClick="SubmitAsync">
                    Add @_parsed.Cards.Count Cards to Collection
                </MudButton>

            </MudStack>
        </MudPaper>
    }

</MudStack>


@inject CollectionImportService ImportService
@inject CollectionService CollectionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@code {

    private List<CollectionBinderDto> BinderCache = [];
    private List<DeckDto> DeckCache = [];
    
    private CollectionBinderDto? _selectedBinder;
    private DeckDto? _selectedDeck;

    private bool _isParsePurchasePrices = true;

    private ImportResult? _result;
    private ParseResult? _parsed;
    private string? _fileName;
    private bool _isLoading;

    private bool CanParse =>
        _result is not null && (
            _result.Cards.All(a => a.ScryfallId.HasValue) ||
            _result.Cards.All(a => !@String.IsNullOrWhiteSpace(a.SetCode) && !@String.IsNullOrWhiteSpace(a.CollNum))
        );

    private bool CanSubmit =>
        _parsed is not null && _parsed.Cards.Count > 0;


    protected override async Task OnInitializedAsync()
    {
        BinderCache = await CollectionService.GetAllBinders();
        DeckCache = await CollectionService.GetAllDecks();
    }
    

    private async Task HandleFileSelected(
        InputFileChangeEventArgs args
    )
    {
        var file = args.File;
        if (file is null)
            return;

        _fileName = file.Name;
        _isLoading = true;
        _result = null;
        _parsed = null;

        try
        {
            const long maxSize = 10 * 1024 * 1024;

            await using var stream = file.OpenReadStream(maxSize);
            _result = await ImportService.ParseStreamAsync(stream);
        }
        catch (Exception ex)
        {
            _result = new ImportResult
            {
                Errors = [$"Failed to read file '{ex.Message}'."]
            };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ParseAsync()
    {
        _parsed = await ImportService.ParseImportAllocationsAsync(
            _result!.Cards,
            _isParsePurchasePrices
        );
    }

    private async Task SubmitAsync()
    {
        if (_parsed is null || _parsed.Cards.Count == 0)
            return;

        await CollectionService.SubmitBatchAsync(
            _parsed.Cards,
            _selectedBinder?.Id,
            _selectedDeck?.ActiveMainboardId
        );

        var target = "Unassigned";
        if (_selectedBinder is not null)
            target = _selectedBinder.Name;
        if (_selectedDeck is not null)
            target = _selectedDeck.Name;

        Snackbar.Add($"{_parsed.Cards.Count} cards succesfully added to '{target}' ~ !", Severity.Success);
        _result = null;
        _parsed = null;
    }


    // Open dialog to add a binder to the collection database
    private async Task OpenAddBinderDialog()
    {
        var options = new DialogOptions 
        {
            CloseButton = true, 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddBinderDialog>("Add Binder", options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is EditBinderCallback callback)
        {
            BinderCache.Add(callback.Binder);
            _selectedBinder = callback.Binder;
            StateHasChanged();
        }
    }

    // Open dialog to add a deck to the collection database
    private async Task OpenAddDeckDialog()
    {
        var options = new DialogOptions 
        {
            CloseButton = true,
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddDeckDialog>("Add Deck", options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is EditDeckCallback callback)
        {
            DeckCache.Add(callback.Deck);
            _selectedDeck = callback.Deck;
            StateHasChanged();
        }
    }

}
